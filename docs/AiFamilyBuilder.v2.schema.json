{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hcb.local/schemas/AiFamilyBuilder.v2.schema.json",
  "title": "HCB AI Family Builder v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "meta", "parameters", "types", "geometry"],
  "properties": {
    "schema": {
      "const": "hcb.ai_family_builder.v2"
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "parameters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parameter"
      }
    },
    "types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/familyType"
      }
    },
    "reference_planes": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/referencePlane"
      }
    },
    "constraints": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/constraint"
      }
    },
    "dimensions": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/constraint"
      }
    },
    "geometry": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/geometryOperation"
      }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "family_name"],
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "family_name": {
          "type": "string",
          "minLength": 1
        },
        "category_hint": {
          "type": "string"
        },
        "template_hint": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": ["family", "shared"]
        },
        "kind": {
          "enum": ["family", "shared"]
        },
        "data_type": {
          "$ref": "#/$defs/dataType"
        },
        "spec_type": {
          "$ref": "#/$defs/dataType"
        },
        "group": {
          "$ref": "#/$defs/group"
        },
        "scope": {
          "enum": ["type", "instance"]
        },
        "is_instance": {
          "type": "boolean"
        },
        "formula": {
          "type": "string"
        }
      }
    },
    "familyType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "values"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean"]
          }
        }
      }
    },
    "referencePlane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "orientation", "offset"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "orientation": {
          "enum": ["vertical", "horizontal"]
        },
        "offset": {
          "type": "number",
          "description": "Offset in millimeters."
        },
        "view": {
          "enum": ["plan", "elevation"]
        },
        "line_direction": {
          "enum": ["vertical", "horizontal"]
        }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "reference_a", "reference_b", "parameter"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "reference_a": {
          "type": "string",
          "minLength": 1
        },
        "reference_b": {
          "type": "string",
          "minLength": 1
        },
        "parameter": {
          "type": "string",
          "minLength": 1
        },
        "orientation": {
          "enum": ["horizontal", "vertical"]
        },
        "view": {
          "enum": ["plan", "elevation"]
        },
        "offset": {
          "type": "number",
          "default": 150,
          "description": "Dimension line offset in millimeters."
        }
      }
    },
    "geometryOperation": {
      "oneOf": [
        {
          "$ref": "#/$defs/rectangularPrism"
        },
        {
          "$ref": "#/$defs/legacyRectangle"
        },
        {
          "$ref": "#/$defs/legacyCircle"
        },
        {
          "$ref": "#/$defs/legacyBlend"
        }
      ]
    },
    "rectangularPrism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "width", "height", "depth"],
      "properties": {
        "kind": {
          "const": "rectangular_prism"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "solid": {
          "type": "boolean",
          "default": true
        },
        "width": {
          "$ref": "#/$defs/parameterRef"
        },
        "height": {
          "$ref": "#/$defs/parameterRef"
        },
        "depth": {
          "$ref": "#/$defs/valueOrRef"
        }
      }
    },
    "legacyRectangle": {
      "type": "object",
      "additionalProperties": true,
      "required": ["width", "height", "depth"],
      "anyOf": [
        {
          "required": ["op"]
        },
        {
          "required": ["kind"]
        }
      ],
      "properties": {
        "op": {
          "enum": ["extrusion_rectangle", "void_rectangle"]
        },
        "kind": {
          "enum": ["extrusion_rectangle", "void_rectangle"]
        },
        "name": {
          "type": "string"
        },
        "width": {
          "$ref": "#/$defs/valueOrRef"
        },
        "height": {
          "$ref": "#/$defs/valueOrRef"
        },
        "depth": {
          "$ref": "#/$defs/valueOrRef"
        }
      }
    },
    "legacyCircle": {
      "type": "object",
      "additionalProperties": true,
      "required": ["radius", "depth"],
      "anyOf": [
        {
          "required": ["op"]
        },
        {
          "required": ["kind"]
        }
      ],
      "properties": {
        "op": {
          "enum": ["extrusion_circle", "void_circle"]
        },
        "kind": {
          "enum": ["extrusion_circle", "void_circle"]
        },
        "name": {
          "type": "string"
        },
        "radius": {
          "$ref": "#/$defs/valueOrRef"
        },
        "depth": {
          "$ref": "#/$defs/valueOrRef"
        }
      }
    },
    "legacyBlend": {
      "type": "object",
      "additionalProperties": true,
      "required": ["top_width", "top_height", "bottom_width", "bottom_height", "depth"],
      "anyOf": [
        {
          "required": ["op"]
        },
        {
          "required": ["kind"]
        }
      ],
      "properties": {
        "op": {
          "const": "blend_rectangle"
        },
        "kind": {
          "const": "blend_rectangle"
        },
        "name": {
          "type": "string"
        },
        "top_width": {
          "$ref": "#/$defs/valueOrRef"
        },
        "top_height": {
          "$ref": "#/$defs/valueOrRef"
        },
        "bottom_width": {
          "$ref": "#/$defs/valueOrRef"
        },
        "bottom_height": {
          "$ref": "#/$defs/valueOrRef"
        },
        "depth": {
          "$ref": "#/$defs/valueOrRef"
        }
      }
    },
    "valueOrRef": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value"],
          "properties": {
            "value": {
              "type": "number"
            }
          }
        },
        {
          "$ref": "#/$defs/parameterRef"
        }
      ]
    },
    "parameterRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dataType": {
      "enum": ["text", "yesno", "integer", "number", "length", "area", "volume", "angle", "material"]
    },
    "group": {
      "enum": ["Data", "Text", "IdentityData", "Construction", "Geometry", "Materials", "Mechanical", "Electrical", "Plumbing"]
    }
  }
}
