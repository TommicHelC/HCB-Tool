<Window x:Class="HCB.RevitAddin.UI.Controls.SingleValueInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HCB.RevitAddin.UI.Controls"
        Title="Wprowadzanie wartości"
        Width="520"
        Height="220"
        MinWidth="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource HcbWindowStyle}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HCB.RevitAddin;component/UI/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Style="{StaticResource DialogRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: the title is set in code-behind (TitleTextBlock), so DialogHeader's layout is mirrored here. -->
        <StackPanel>
            <TextBlock x:Name="TitleTextBlock"
                       Style="{StaticResource SectionTitleStyle}" />
            <Border Margin="{StaticResource Space.Section}"
                    Style="{StaticResource DividerStyle}" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Margin="{StaticResource Space.Section}">
            <TextBlock x:Name="PromptTextBlock"
                       Margin="0,0,0,4"
                       Style="{StaticResource SectionLabelStyle}"
                       TextWrapping="Wrap" />
            <TextBox x:Name="ValueTextBox" />
        </StackPanel>

        <controls:DialogFooterBar x:Name="FooterBar"
                                  Grid.Row="2"
                                  Margin="{StaticResource Space.Section}"
                                  PrimaryButtonText="Zastosuj"
                                  SecondaryButtonText="Anuluj"
                                  PrimaryButtonClick="ConfirmButton_OnClick"
                                  SecondaryButtonClick="CancelButton_OnClick" />
    </Grid>
</Window>
