<Window x:Class="HCB.RevitAddin.UI.Controls.ReportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Podgląd raportu"
        Width="980"
        Height="720"
        MinWidth="760"
        MinHeight="560"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource HcbWindowStyle}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HCB.RevitAddin;component/UI/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Style="{StaticResource DialogRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title and summary are set in code-behind, so DialogHeader's layout is mirrored here
             with the CSV export action on the right. -->
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TitleTextBlock"
                               Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock x:Name="SummaryTextBlock"
                               Style="{StaticResource WindowDescriptionStyle}" />
                </StackPanel>
                <Button x:Name="ExportButton"
                        Grid.Column="1"
                        Margin="16,0,0,0"
                        VerticalAlignment="Top"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="Eksportuj CSV"
                        Click="ExportButton_OnClick" />
            </Grid>
            <Border Margin="{StaticResource Space.Section}"
                    Style="{StaticResource DividerStyle}" />
        </StackPanel>

        <DockPanel Grid.Row="1"
                   Margin="{StaticResource Space.Section}"
                   LastChildFill="True">
            <Grid DockPanel.Dock="Top"
                  Margin="{StaticResource Space.Field}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabelStyle}"
                           Text="Kolumna" />
                <ComboBox x:Name="FilterColumnComboBox"
                          Grid.Column="1"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Value"
                          SelectionChanged="FilterColumnComboBox_OnSelectionChanged" />
                <TextBlock Grid.Column="3"
                           Style="{StaticResource FieldLabelStyle}"
                           Text="Filtr" />
                <ComboBox x:Name="FilterValueComboBox"
                          Grid.Column="4"
                          IsEditable="True"
                          IsTextSearchEnabled="False"
                          StaysOpenOnEdit="True"
                          SelectionChanged="FilterValueComboBox_OnSelectionChanged"
                          KeyUp="FilterValueComboBox_OnKeyUp"
                          LostFocus="FilterValueComboBox_OnLostFocus" />
            </Grid>

            <Border x:Name="FooterSummaryBorder"
                    DockPanel.Dock="Bottom"
                    Margin="{StaticResource Space.Section}"
                    Style="{StaticResource InfoPanelStyle}"
                    Visibility="Collapsed">
                <TextBlock x:Name="FooterSummaryTextBlock"
                           Style="{StaticResource HintTextStyle}" />
            </Border>

            <DataGrid x:Name="ReportDataGrid"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Extended"
                      SelectionChanged="ReportDataGrid_OnSelectionChanged"
                      MouseDoubleClick="ReportDataGrid_OnMouseDoubleClick"
                      AutoGeneratingColumn="ReportDataGrid_OnAutoGeneratingColumn"
                      RowHeaderWidth="0" />
        </DockPanel>

        <!-- Footer: mirrors DialogFooterBar (divider, status left, actions right). Kept as plain buttons
             because code-behind drives the extra action buttons and the row count text directly. -->
        <StackPanel Grid.Row="2"
                    Margin="{StaticResource Space.Section}">
            <Border Margin="0,0,0,12"
                    Style="{StaticResource DividerStyle}" />
            <Grid MinHeight="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="RowsCountTextBlock"
                           Margin="0,0,16,0"
                           Style="{StaticResource StatusTextStyle}" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="OpenLocationButton"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="Otwórz lokalizację"
                            Click="OpenLocationButton_OnClick" />
                    <Button x:Name="BatchActionButton"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Visibility="Collapsed"
                            Click="BatchActionButton_OnClick" />
                    <Button x:Name="RowActionButton"
                            MinWidth="110"
                            Margin="0,0,8,0"
                            Visibility="Collapsed"
                            Click="RowActionButton_OnClick" />
                    <Button MinWidth="90"
                            IsCancel="True"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="Zamknij"
                            Click="CloseButton_OnClick" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
