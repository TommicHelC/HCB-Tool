<Window x:Class="HCB.RevitAddin.UI.Controls.NumberingOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HCB.RevitAddin.UI.Controls"
        Title="Opcje numeracji"
        Width="520"
        Height="420"
        MinWidth="480"
        MinHeight="410"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource HcbWindowStyle}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HCB.RevitAddin;component/UI/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Style="{StaticResource DialogRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: the title is set in code-behind (TitleTextBlock), so DialogHeader's layout is mirrored here. -->
        <StackPanel>
            <TextBlock x:Name="TitleTextBlock"
                       Style="{StaticResource SectionTitleStyle}" />
            <Border Margin="{StaticResource Space.Section}"
                    Style="{StaticResource DividerStyle}" />
        </StackPanel>

        <GroupBox Grid.Row="1"
                  Margin="{StaticResource Space.Section}"
                  VerticalAlignment="Top"
                  Header="Ustawienia numeracji">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource FormLabelColumnWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Margin="0,0,12,8"
                           Style="{StaticResource FieldLabelStyle}"
                           Text="Parametr docelowy" />
                <ComboBox x:Name="ParameterComboBox"
                          Grid.Column="1"
                          Margin="{StaticResource Space.Field}" />

                <TextBlock Grid.Row="1"
                           Margin="0,0,12,8"
                           Style="{StaticResource FieldLabelStyle}"
                           Text="Numer startowy" />
                <TextBox x:Name="StartNumberTextBox"
                         Grid.Row="1"
                         Grid.Column="1"
                         Margin="{StaticResource Space.Field}"
                         Text="1" />

                <CheckBox x:Name="UseLastProjectNumberCheckBox"
                          Grid.Row="2"
                          Grid.Column="1"
                          Margin="0,0,0,12">
                    <TextBlock Text="Pobierz ostatni numer z projektu i zacznij od kolejnego"
                               TextWrapping="Wrap" />
                </CheckBox>

                <TextBlock Grid.Row="3"
                           Margin="0,0,12,8"
                           Style="{StaticResource FieldLabelStyle}"
                           Text="Prefiks" />
                <TextBox x:Name="PrefixTextBox"
                         Grid.Row="3"
                         Grid.Column="1"
                         Margin="{StaticResource Space.Field}" />

                <TextBlock Grid.Row="4"
                           Style="{StaticResource FieldLabelStyle}"
                           Text="Sufiks" />
                <TextBox x:Name="SuffixTextBox"
                         Grid.Row="4"
                         Grid.Column="1" />
            </Grid>
        </GroupBox>

        <controls:DialogFooterBar x:Name="FooterBar"
                                  Grid.Row="2"
                                  Margin="{StaticResource Space.Section}"
                                  PrimaryButtonText="Numeruj"
                                  SecondaryButtonText="Anuluj"
                                  PrimaryButtonClick="ConfirmButton_OnClick"
                                  SecondaryButtonClick="CancelButton_OnClick" />
    </Grid>
</Window>
