<UserControl x:Class="HCB.RevitAddin.UI.Controls.SelectionActionsBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HCB.RevitAddin;component/UI/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <WrapPanel Orientation="Horizontal">
        <Button Style="{StaticResource InlineActionButtonStyle}"
                Content="{Binding LeftButtonText, ElementName=Root}"
                Click="LeftButton_OnClick" />
        <Button Margin="6,0,0,0"
                Style="{StaticResource InlineActionButtonStyle}"
                Content="{Binding RightButtonText, ElementName=Root}"
                Click="RightButton_OnClick" />
    </WrapPanel>
</UserControl>
