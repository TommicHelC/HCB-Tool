<Window x:Class="HCB.RevitAddin.UI.Controls.ColorSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HCB.RevitAddin.UI.Controls"
        Title="Wybór kolorów"
        Width="640"
        Height="720"
        MinWidth="520"
        MinHeight="560"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource HcbWindowStyle}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HCB.RevitAddin;component/UI/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Style="{StaticResource DialogRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: the title is set in code-behind (TitleTextBlock), so DialogHeader's layout is mirrored here. -->
        <StackPanel>
            <TextBlock x:Name="TitleTextBlock"
                       Style="{StaticResource SectionTitleStyle}" />
            <Border Margin="{StaticResource Space.Section}"
                    Style="{StaticResource DividerStyle}" />
        </StackPanel>

        <DockPanel Grid.Row="1"
                   Margin="{StaticResource Space.Section}"
                   LastChildFill="True">
            <TextBlock DockPanel.Dock="Top"
                       Margin="0,0,0,4"
                       Style="{StaticResource SectionLabelStyle}"
                       Text="Szukaj" />
            <TextBox x:Name="SearchTextBox"
                     DockPanel.Dock="Top"
                     TextChanged="SearchTextBox_OnTextChanged" />

            <CheckBox x:Name="BlackLinesCheckBox"
                      DockPanel.Dock="Bottom"
                      Margin="{StaticResource Space.Section}"
                      Content="Nadpisz linie wyświetlania na czarne, grubość 1" />

            <GroupBox x:Name="ItemsGroupBox"
                      Margin="{StaticResource Space.Section}">
                <DockPanel LastChildFill="True">
                    <ComboBox x:Name="FilterGroupComboBox"
                              DockPanel.Dock="Top"
                              Margin="{StaticResource Space.Field}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Value"
                              SelectionChanged="FilterGroupComboBox_OnSelectionChanged"
                              Visibility="Collapsed" />
                    <controls:SelectionActionsBar DockPanel.Dock="Top"
                                                  Margin="{StaticResource Space.Field}"
                                                  LeftButtonText="Wszystkie"
                                                  RightButtonText="Brak"
                                                  LeftButtonClick="SelectAllButton_OnClick"
                                                  RightButtonClick="SelectNoneButton_OnClick" />
                    <ListBox x:Name="ItemsListBox"
                             SelectionMode="Extended">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <Border Width="16"
                                            Height="16"
                                            Margin="0,0,10,0"
                                            CornerRadius="2"
                                            BorderBrush="{StaticResource Brush.BorderStrong}"
                                            BorderThickness="1"
                                            Background="{Binding PreviewBrush}"
                                            DockPanel.Dock="Left" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="{Binding DisplayName}" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </GroupBox>
        </DockPanel>

        <controls:DialogFooterBar x:Name="FooterBar"
                                  Grid.Row="2"
                                  Margin="{StaticResource Space.Section}"
                                  PrimaryButtonText="Wybierz"
                                  SecondaryButtonText="Anuluj"
                                  PrimaryButtonClick="ConfirmButton_OnClick"
                                  SecondaryButtonClick="CancelButton_OnClick" />
    </Grid>
</Window>
