<Window x:Class="HCB.RevitAddin.UI.Controls.SelectionListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HCB.RevitAddin.UI.Controls"
        Title="Wybór elementów"
        Width="640"
        Height="720"
        MinWidth="480"
        MinHeight="520"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource HcbWindowStyle}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HCB.RevitAddin;component/UI/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Style="{StaticResource DialogRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: the title is set in code-behind (TitleTextBlock), so DialogHeader's layout is mirrored here. -->
        <StackPanel>
            <TextBlock x:Name="TitleTextBlock"
                       Style="{StaticResource SectionTitleStyle}" />
            <Border Margin="{StaticResource Space.Section}"
                    Style="{StaticResource DividerStyle}" />
        </StackPanel>

        <DockPanel Grid.Row="1"
                   Margin="{StaticResource Space.Section}"
                   LastChildFill="True">
            <TextBlock DockPanel.Dock="Top"
                       Margin="0,0,0,4"
                       Style="{StaticResource SectionLabelStyle}"
                       Text="Szukaj" />
            <TextBox x:Name="SearchTextBox"
                     DockPanel.Dock="Top"
                     Margin="{StaticResource Space.Field}"
                     TextChanged="SearchTextBox_OnTextChanged" />

            <StackPanel x:Name="PrimaryFilterPanel"
                        DockPanel.Dock="Top"
                        Margin="{StaticResource Space.Field}"
                        Visibility="Collapsed">
                <TextBlock x:Name="PrimaryFilterLabelTextBlock"
                           Margin="0,0,0,4"
                           Style="{StaticResource SectionLabelStyle}" />
                <ComboBox x:Name="FilterGroupComboBox"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Value"
                          SelectionChanged="FilterGroupComboBox_OnSelectionChanged" />
            </StackPanel>

            <StackPanel x:Name="SecondaryFilterPanel"
                        DockPanel.Dock="Top"
                        Margin="{StaticResource Space.Field}"
                        Visibility="Collapsed">
                <TextBlock x:Name="SecondaryFilterLabelTextBlock"
                           Margin="0,0,0,4"
                           Style="{StaticResource SectionLabelStyle}" />
                <ComboBox x:Name="SecondaryFilterGroupComboBox"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Value"
                          SelectionChanged="SecondaryFilterGroupComboBox_OnSelectionChanged" />
            </StackPanel>

            <CheckBox x:Name="ActiveViewCheckBox"
                      DockPanel.Dock="Top"
                      Margin="{StaticResource Space.Field}"
                      Content="Active View"
                      Checked="ActiveViewCheckBox_OnChecked"
                      Unchecked="ActiveViewCheckBox_OnUnchecked"
                      Visibility="Collapsed" />

            <GroupBox x:Name="ItemsGroupBox"
                      Margin="0,4,0,0">
                <DockPanel LastChildFill="True">
                    <controls:SelectionActionsBar DockPanel.Dock="Top"
                                                  Margin="{StaticResource Space.Field}"
                                                  LeftButtonText="Wszystkie"
                                                  RightButtonText="Brak"
                                                  LeftButtonClick="SelectAllButton_OnClick"
                                                  RightButtonClick="SelectNoneButton_OnClick" />
                    <ListBox x:Name="ItemsListBox"
                             DisplayMemberPath="DisplayName"
                             SelectionMode="Extended" />
                </DockPanel>
            </GroupBox>
        </DockPanel>

        <controls:DialogFooterBar x:Name="FooterBar"
                                  Grid.Row="2"
                                  Margin="{StaticResource Space.Section}"
                                  PrimaryButtonText="Wybierz"
                                  SecondaryButtonText="Anuluj"
                                  PrimaryButtonClick="ConfirmButton_OnClick"
                                  SecondaryButtonClick="CancelButton_OnClick" />
    </Grid>
</Window>
