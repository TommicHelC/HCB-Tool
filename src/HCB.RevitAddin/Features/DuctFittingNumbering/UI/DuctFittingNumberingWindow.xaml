<Window x:Class="HCB.RevitAddin.Features.DuctFittingNumbering.UI.DuctFittingNumberingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HCB.RevitAddin.UI.Controls"
        Title="Duct and Fitting Numbering"
        Width="560"
        Height="380"
        MinWidth="480"
        MinHeight="340"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource HcbWindowStyle}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HCB.RevitAddin;component/UI/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Style="{StaticResource DialogRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Heading text is set from code (WindowTitleTextBlock.Text); the header mirrors it. -->
        <TextBlock x:Name="WindowTitleTextBlock"
                   Text="Duct and Fitting Numbering"
                   Visibility="Collapsed" />
        <controls:DialogHeader Title="{Binding Text, ElementName=WindowTitleTextBlock}"
                               Description="Nadaje kolejne numery kanałom i kształtkom, grupując elementy o tych samych parametrach." />

        <ScrollViewer Grid.Row="1"
                      Margin="{StaticResource Space.Section}"
                      VerticalScrollBarVisibility="Auto">
            <GroupBox x:Name="OptionsGroupBox"
                      VerticalAlignment="Top"
                      Header="Opcje numeracji">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource FormLabelColumnWidth}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="LengthParameterSpacerRow" Height="Auto" />
                        <RowDefinition x:Name="LengthParameterRow" Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Margin="0,0,12,8"
                               Style="{StaticResource FieldLabelStyle}"
                               Text="Parametr docelowy" />
                    <ComboBox x:Name="TargetParameterComboBox"
                              Grid.Row="0"
                              Grid.Column="1"
                              Margin="{StaticResource Space.Field}" />

                    <TextBlock x:Name="LengthParameterLabel"
                               Grid.Row="2"
                               Margin="0,0,12,8"
                               Style="{StaticResource FieldLabelStyle}"
                               Text="Parametr długości" />
                    <ComboBox x:Name="LengthParameterComboBox"
                              Grid.Row="2"
                              Grid.Column="1"
                              Margin="{StaticResource Space.Field}" />

                    <CheckBox x:Name="IncludeSystemParameterCheckBox"
                              Grid.Row="3"
                              Grid.Column="1"
                              Margin="0,4,0,8">
                        <TextBlock Text="Dodaj HC_System do numeru, jeśli cała grupa ma jedną wspólną wartość"
                                   TextWrapping="Wrap" />
                    </CheckBox>
                    <CheckBox x:Name="UseLastProjectNumberCheckBox"
                              Grid.Row="4"
                              Grid.Column="1"
                              Content="Pobierz ostatni numer z projektu i zacznij od kolejnego" />
                </Grid>
            </GroupBox>
        </ScrollViewer>

        <controls:DialogFooterBar x:Name="FooterBar"
                                  Grid.Row="2"
                                  Margin="{StaticResource Space.Section}"
                                  PrimaryButtonText="Numeruj"
                                  SecondaryButtonText="Anuluj"
                                  PrimaryButtonClick="ConfirmButton_OnClick"
                                  SecondaryButtonClick="CancelButton_OnClick" />
    </Grid>
</Window>
