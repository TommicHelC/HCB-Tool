<Window x:Class="HCB.RevitAddin.Features.ViewFiltersLegend.UI.ViewFiltersLegendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HCB.RevitAddin.UI.Controls"
        Title="View Filters Legend"
        Width="540"
        Height="560"
        MinWidth="480"
        MinHeight="480"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource HcbWindowStyle}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HCB.RevitAddin;component/UI/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Style="{StaticResource DialogRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:DialogHeader Title="View Filters Legend"
                               Description="Tworzy legendę filtrów widoku z próbkami linii i wzorów wypełnienia." />

        <ScrollViewer Grid.Row="1"
                      Margin="{StaticResource Space.Section}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Ustawienia legendy">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource FormLabelColumnWidth}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Margin="0,0,12,8"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Text="Typ tekstu" />
                        <ComboBox x:Name="TextTypeComboBox"
                                  Grid.Column="1"
                                  Margin="{StaticResource Space.Field}" />

                        <TextBlock Grid.Row="1"
                                   Margin="0,0,12,8"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Text="Szerokość [mm]" />
                        <TextBox x:Name="RegionWidthTextBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Margin="{StaticResource Space.Field}"
                                 Text="150" />

                        <TextBlock Grid.Row="2"
                                   Margin="0,0,12,8"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Text="Wysokość [mm]" />
                        <TextBox x:Name="RegionHeightTextBox"
                                 Grid.Row="2"
                                 Grid.Column="1"
                                 Margin="{StaticResource Space.Field}"
                                 Text="80" />

                        <TextBlock Grid.Row="3"
                                   Margin="0,0,12,8"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Text="Odstęp [mm]" />
                        <TextBox x:Name="SpacingTextBox"
                                 Grid.Row="3"
                                 Grid.Column="1"
                                 Margin="{StaticResource Space.Field}"
                                 Text="50" />

                        <TextBlock Grid.Row="4"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Text="Długość linii [mm]" />
                        <TextBox x:Name="LineWidthTextBox"
                                 Grid.Row="4"
                                 Grid.Column="1"
                                 Text="200" />
                    </Grid>
                </GroupBox>

                <GroupBox Margin="{StaticResource Space.Section}"
                          Header="Elementy legendy">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="ProjectionLineCheckBox"
                                  Margin="0,0,12,8"
                                  Content="Projection line"
                                  IsChecked="True" />
                        <CheckBox x:Name="CutLineCheckBox"
                                  Grid.Column="1"
                                  Margin="0,0,0,8"
                                  Content="Cut line"
                                  IsChecked="True" />
                        <CheckBox x:Name="SurfaceFillCheckBox"
                                  Grid.Row="1"
                                  Margin="0,0,12,8"
                                  Content="Projection pattern"
                                  IsChecked="True" />
                        <CheckBox x:Name="CutFillCheckBox"
                                  Grid.Row="1"
                                  Grid.Column="1"
                                  Margin="0,0,0,8"
                                  Content="Cut pattern"
                                  IsChecked="True" />
                        <CheckBox x:Name="FilterNameCheckBox"
                                  Grid.Row="2"
                                  Content="Filter name"
                                  IsChecked="True" />
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <controls:DialogFooterBar x:Name="FooterBar"
                                  Grid.Row="2"
                                  Margin="{StaticResource Space.Section}"
                                  PrimaryButtonText="Generuj"
                                  SecondaryButtonText="Anuluj"
                                  PrimaryButtonClick="ConfirmButton_OnClick"
                                  SecondaryButtonClick="CancelButton_OnClick" />
    </Grid>
</Window>
