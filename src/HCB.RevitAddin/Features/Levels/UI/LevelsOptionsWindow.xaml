<Window x:Class="HCB.RevitAddin.Features.Levels.UI.LevelsOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HCB.RevitAddin.UI.Controls"
        Title="Aktualizacja nazw poziomów"
        Width="540"
        Height="460"
        MinWidth="480"
        MinHeight="420"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource HcbWindowStyle}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HCB.RevitAddin;component/UI/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Style="{StaticResource DialogRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:DialogHeader Title="Aktualizacja nazw poziomów"
                               Description="Dopisuje rzędną na końcu nazwy każdego poziomu w wybranym formacie." />

        <ScrollViewer Grid.Row="1"
                      Margin="{StaticResource Space.Section}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource InfoPanelStyle}">
                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Text="Narzędzie usuwa poprzedni dopisek rzędnej z końca nazwy i wpisuje nowy format." />
                </Border>

                <GroupBox Margin="{StaticResource Space.Section}"
                          Header="Format rzędnej">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource FormLabelColumnWidth}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Margin="0,0,12,8"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Text="Miejsca po przecinku" />
                        <ComboBox x:Name="DecimalPlacesComboBox"
                                  Grid.Row="0"
                                  Grid.Column="1"
                                  Margin="{StaticResource Space.Field}"
                                  SelectedIndex="2">
                            <ComboBoxItem Content="0" />
                            <ComboBoxItem Content="1" />
                            <ComboBoxItem Content="2" />
                            <ComboBoxItem Content="3" />
                        </ComboBox>

                        <TextBlock Grid.Row="1"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Text="Wartości dodatnie" />
                        <CheckBox x:Name="ShowPlusCheckBox"
                                  Grid.Row="1"
                                  Grid.Column="1"
                                  Content="Pokazuj znak +"
                                  IsChecked="True"
                                  Checked="OptionsChanged"
                                  Unchecked="OptionsChanged" />
                    </Grid>
                </GroupBox>

                <Border Margin="{StaticResource Space.Section}"
                        Style="{StaticResource PreviewPanelStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabelStyle}"
                                   Text="Podgląd" />
                        <TextBlock x:Name="PreviewTextBlock"
                                   Margin="0,6,0,0"
                                   Style="{StaticResource EmphasisTextStyle}"
                                   Text="Poziom 1 (+3.20)" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource HintTextStyle}"
                                   Text="Przykład nazwy poziomu po aktualizacji." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <controls:DialogFooterBar x:Name="FooterBar"
                                  Grid.Row="2"
                                  Margin="{StaticResource Space.Section}"
                                  PrimaryButtonText="Aktualizuj poziomy"
                                  SecondaryButtonText="Anuluj"
                                  PrimaryButtonClick="ConfirmButton_OnClick"
                                  SecondaryButtonClick="CancelButton_OnClick" />
    </Grid>
</Window>
