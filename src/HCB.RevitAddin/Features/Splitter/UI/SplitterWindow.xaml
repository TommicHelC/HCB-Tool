<Window x:Class="HCB.RevitAddin.Features.Splitter.UI.SplitterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HCB.RevitAddin.UI.Controls"
        Title="Splitter"
        Width="560"
        Height="420"
        MinWidth="480"
        MinHeight="380"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource HcbWindowStyle}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HCB.RevitAddin;component/UI/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Style="{StaticResource DialogRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:DialogHeader Title="Splitter"
                               Description="Dzieli kanały i rury na odcinki produkcyjne o zadanej długości." />

        <ScrollViewer Grid.Row="1"
                      Margin="{StaticResource Space.Section}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Ustawienia podziału">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource FormLabelColumnWidth}" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Margin="0,0,12,8"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Text="Długość odcinka" />
                        <TextBox x:Name="SegmentLengthTextBox"
                                 Grid.Column="1"
                                 Margin="{StaticResource Space.Field}" />
                        <TextBlock Grid.Column="2"
                                   Margin="8,0,0,8"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Text="mm" />

                        <TextBlock Grid.Row="1"
                                   VerticalAlignment="Top"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Text="Zakres" />
                        <StackPanel Grid.Row="1"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2">
                            <CheckBox x:Name="DuctsCheckBox"
                                      Margin="{StaticResource Space.Field}"
                                      Content="Ducts" />
                            <CheckBox x:Name="PipesCheckBox"
                                      Content="Pipes" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <Border Margin="{StaticResource Space.Section}"
                        Style="{StaticResource InfoPanelStyle}">
                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Text="Po zatwierdzeniu klikaj wielokrotnie kanały i rury. Strona startowa jest wyznaczana automatycznie na podstawie miejsca kliknięcia bliżej jednego z konektorów. Reszta długości zostanie na przeciwnym końcu." />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <controls:DialogFooterBar x:Name="FooterBar"
                                  Grid.Row="2"
                                  Margin="{StaticResource Space.Section}"
                                  PrimaryButtonText="Rozpocznij"
                                  SecondaryButtonText="Anuluj"
                                  PrimaryButtonClick="ConfirmButton_OnClick"
                                  SecondaryButtonClick="CancelButton_OnClick" />
    </Grid>
</Window>
