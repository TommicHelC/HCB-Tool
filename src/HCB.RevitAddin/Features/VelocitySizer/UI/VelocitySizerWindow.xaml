<Window x:Class="HCB.RevitAddin.Features.VelocitySizer.UI.VelocitySizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HCB.RevitAddin.UI.Controls"
        xmlns:local="clr-namespace:HCB.RevitAddin.Features.VelocitySizer.UI"
        Title="Velocity Sizer"
        Width="1120"
        Height="720"
        MinWidth="960"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HCB.RevitAddin;component/UI/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:VelocityToBrushConverter x:Key="VelocityBrush" />

            <Style x:Key="ElementRowStyle" TargetType="DataGridRow">
                <Setter Property="Background"
                        Value="{Binding SelectedVelocity, Converter={StaticResource VelocityBrush}}" />
            </Style>

            <Style x:Key="CandidateRowStyle" TargetType="DataGridRow">
                <Setter Property="Background"
                        Value="{Binding VelocityMetersPerSecond, Converter={StaticResource VelocityBrush}}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Velocity Sizer"
                       Style="{StaticResource SectionTitleStyle}" />
            <TextBlock Margin="0,6,0,0"
                       Foreground="{StaticResource Brush.TextSecondary}"
                       TextWrapping="Wrap"
                       Text="Zakres: zaznaczone okragle kanaly i rury. Wpisz przeplyw w m3/h, wybierz standardowy rozmiar z projektu i zatwierdz zmiane srednicy oraz parametrow LIN_VE_*." />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,12,0,0"
                Padding="12"
                Background="{StaticResource Brush.SurfaceAlt}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="8">
            <TextBlock x:Name="InfoTextBlock"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.TextSecondary}" />
        </Border>

        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Padding="12"
                Background="{StaticResource Brush.SurfaceAlt}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Tryb automatyczny"
                           Style="{StaticResource SectionLabelStyle}"
                           VerticalAlignment="Center" />
                <TextBlock Margin="16,0,8,0"
                           Text="Max. v [m/s]:"
                           Style="{StaticResource StatusTextStyle}" />
                <TextBox x:Name="MaxVelocityTextBox"
                         Width="30"
                         Text="4" />
                <Button Margin="12,0,0,0"
                        Width="170"
                        Click="AutoSizeAllButton_OnClick"
                        Content="Dobierz wszystkie" />
                <Button Margin="8,0,0,0"
                        Width="190"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="AutoSizeSelectedButton_OnClick"
                        Content="Dobierz zaznaczony" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Wybrane elementy">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="ElementsDataGrid"
                              Grid.Row="0"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Extended"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              MinRowHeight="24"
                              RowStyle="{StaticResource ElementRowStyle}"
                              CellEditEnding="ElementsDataGrid_OnCellEditEnding"
                              SelectionChanged="ElementsDataGrid_OnSelectionChanged"
                              MouseDoubleClick="ElementsDataGrid_OnMouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Id"
                                            Binding="{Binding ElementId}"
                                            IsReadOnly="True"
                                            Width="60" />
                        <DataGridTextColumn Header="Typ"
                                            Binding="{Binding ElementTypeLabel}"
                                            IsReadOnly="True"
                                            Width="40" />
                        <DataGridTextColumn Header="Ksztalt"
                                            Binding="{Binding SupportedShapeLabel}"
                                            IsReadOnly="True"
                                            Width="50" />
                        <DataGridTextColumn Header="Sq"
                                            Binding="{Binding SectionLabel}"
                                            IsReadOnly="True"
                                            Width="30" />
                        <DataGridTextColumn Header="Rozmiar"
                                            Binding="{Binding CurrentSizeDisplay}"
                                            IsReadOnly="True"
                                            Width="60" />
                        <DataGridTextColumn Header="Q[m3/h]"
                                            Binding="{Binding FlowText, UpdateSourceTrigger=PropertyChanged}"
                                            Width="60" />
                        <DataGridTextColumn Header="Nowy rozmiar"
                                            Binding="{Binding SelectedSizeDisplay}"
                                            IsReadOnly="True"
                                            Width="60" />
                        <DataGridTextColumn Header="v [m/s]"
                                            Binding="{Binding SelectedVelocityDisplay}"
                                            IsReadOnly="True"
                                            Width="30" />
                    </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1"
                                Margin="0,12,0,0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left">
                        <Button Width="160"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ShowInModelButton_OnClick"
                                Content="Pokaz w modelu" />
                        <Button Margin="8,0,0,0"
                                Width="260"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="SaveParametersButton_OnClick"
                                Content="Zapisz parametry (bez zmiany geometrii)" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Standardowe rozmiary">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="CandidatesDataGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              MinRowHeight="24"
                              RowStyle="{StaticResource CandidateRowStyle}"
                              MouseDoubleClick="CandidatesDataGrid_OnMouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Rozmiar"
                                                Binding="{Binding DisplayName}"
                                                IsReadOnly="True"
                                                Width="110" />
                            <DataGridTextColumn Header="Pole [m2]"
                                                Binding="{Binding AreaSquareMeters, StringFormat=0.####}"
                                                IsReadOnly="True"
                                                Width="110" />
                            <DataGridTextColumn Header="Predkosc [m/s]"
                                                Binding="{Binding VelocityMetersPerSecond, StringFormat=0.##}"
                                                IsReadOnly="True"
                                                Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1"
                                Margin="0,12,0,0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Width="156"
                                Click="AssignCandidateButton_OnClick"
                                Content="Przypisz rozmiar" />
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <controls:DialogFooterBar x:Name="FooterBar"
                                  Grid.Row="5"
                                  Margin="0,16,0,0"
                                  PrimaryButtonText="Zastosuj"
                                  SecondaryButtonText="Anuluj"
                                  PrimaryButtonClick="ConfirmButton_OnClick"
                                  SecondaryButtonClick="CancelButton_OnClick" />
    </Grid>
</Window>
