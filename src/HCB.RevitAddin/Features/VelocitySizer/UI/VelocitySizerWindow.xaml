<Window x:Class="HCB.RevitAddin.Features.VelocitySizer.UI.VelocitySizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HCB.RevitAddin.UI.Controls"
        xmlns:local="clr-namespace:HCB.RevitAddin.Features.VelocitySizer.UI"
        Title="Velocity Sizer"
        Width="1120"
        Height="720"
        MinWidth="960"
        MinHeight="620"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource HcbWindowStyle}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HCB.RevitAddin;component/UI/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:VelocityToBrushConverter x:Key="VelocityBrush" />

            <Style x:Key="ElementRowStyle" TargetType="DataGridRow">
                <Setter Property="Background"
                        Value="{Binding SelectedVelocity, Converter={StaticResource VelocityBrush}}" />
            </Style>

            <Style x:Key="CandidateRowStyle" TargetType="DataGridRow">
                <Setter Property="Background"
                        Value="{Binding VelocityMetersPerSecond, Converter={StaticResource VelocityBrush}}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Style="{StaticResource DialogRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:DialogHeader Title="Velocity Sizer"
                               Description="Dobiera standardowe średnice okrągłych kanałów i rur na podstawie przepływu i prędkości." />

        <Border Grid.Row="1"
                Margin="{StaticResource Space.Section}"
                Style="{StaticResource InfoPanelStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource HintTextStyle}"
                           Text="Zakres: zaznaczone okrągłe kanały i rury. Wpisz przepływ w m3/h, wybierz standardowy rozmiar z projektu i zatwierdź zmianę średnicy oraz parametrów LIN_VE_*." />
                <TextBlock x:Name="InfoTextBlock"
                           Margin="0,4,0,0"
                           Style="{StaticResource HintTextStyle}" />
            </StackPanel>
        </Border>

        <GroupBox Grid.Row="2"
                  Margin="{StaticResource Space.Section}"
                  Header="Tryb automatyczny">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabelStyle}"
                           Text="Max. v [m/s]" />
                <TextBox x:Name="MaxVelocityTextBox"
                         Width="56"
                         Text="4" />
                <Button Margin="12,0,0,0"
                        Click="AutoSizeAllButton_OnClick"
                        Content="Dobierz wszystkie" />
                <Button Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="AutoSizeSelectedButton_OnClick"
                        Content="Dobierz zaznaczony" />
            </WrapPanel>
        </GroupBox>

        <Grid Grid.Row="3"
              Margin="{StaticResource Space.Section}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <GridSplitter Grid.Column="1"
                          Style="{StaticResource SplitterStyle}" />

            <GroupBox Grid.Column="0" Header="Wybrane elementy">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="ElementsDataGrid"
                              Grid.Row="0"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Extended"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              MinRowHeight="24"
                              RowStyle="{StaticResource ElementRowStyle}"
                              CellEditEnding="ElementsDataGrid_OnCellEditEnding"
                              SelectionChanged="ElementsDataGrid_OnSelectionChanged"
                              MouseDoubleClick="ElementsDataGrid_OnMouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Id"
                                            Binding="{Binding ElementId}"
                                            IsReadOnly="True"
                                            Width="60" />
                        <DataGridTextColumn Header="Typ"
                                            Binding="{Binding ElementTypeLabel}"
                                            IsReadOnly="True"
                                            Width="40" />
                        <DataGridTextColumn Header="Kształt"
                                            Binding="{Binding SupportedShapeLabel}"
                                            IsReadOnly="True"
                                            Width="Auto" />
                        <DataGridTextColumn Header="Sq"
                                            Binding="{Binding SectionLabel}"
                                            IsReadOnly="True"
                                            Width="Auto" />
                        <DataGridTextColumn Header="Rozmiar"
                                            Binding="{Binding CurrentSizeDisplay}"
                                            IsReadOnly="True"
                                            Width="Auto" />
                        <DataGridTextColumn Header="Q[m3/h]"
                                            Binding="{Binding FlowText, UpdateSourceTrigger=PropertyChanged}"
                                            Width="Auto" />
                        <DataGridTextColumn Header="Nowy rozmiar"
                                            Binding="{Binding SelectedSizeDisplay}"
                                            IsReadOnly="True"
                                            Width="Auto" />
                        <DataGridTextColumn Header="v [m/s]"
                                            Binding="{Binding SelectedVelocityDisplay}"
                                            IsReadOnly="True"
                                            Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <WrapPanel Grid.Row="1"
                               Margin="0,8,0,0"
                               Orientation="Horizontal"
                               HorizontalAlignment="Left">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Click="ShowInModelButton_OnClick"
                                Content="Pokaż w modelu" />
                        <Button Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="SaveParametersButton_OnClick"
                                Content="Zapisz parametry (bez zmiany geometrii)" />
                    </WrapPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Standardowe rozmiary">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="CandidatesDataGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              MinRowHeight="24"
                              RowStyle="{StaticResource CandidateRowStyle}"
                              MouseDoubleClick="CandidatesDataGrid_OnMouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Rozmiar"
                                                Binding="{Binding DisplayName}"
                                                IsReadOnly="True"
                                                Width="110" />
                            <DataGridTextColumn Header="Pole [m2]"
                                                Binding="{Binding AreaSquareMeters, StringFormat=0.####}"
                                                IsReadOnly="True"
                                                Width="110" />
                            <DataGridTextColumn Header="Prędkość [m/s]"
                                                Binding="{Binding VelocityMetersPerSecond, StringFormat=0.##}"
                                                IsReadOnly="True"
                                                Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1"
                                Margin="0,8,0,0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Click="AssignCandidateButton_OnClick"
                                Content="Przypisz rozmiar" />
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <controls:DialogFooterBar x:Name="FooterBar"
                                  Grid.Row="4"
                                  Margin="{StaticResource Space.Section}"
                                  PrimaryButtonText="Zastosuj"
                                  SecondaryButtonText="Anuluj"
                                  PrimaryButtonClick="ConfirmButton_OnClick"
                                  SecondaryButtonClick="CancelButton_OnClick" />
    </Grid>
</Window>
