<Window x:Class="HCB.RevitAddin.Features.AccessoryTerminalNumbering.UI.AccessoryTerminalNumberingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HCB.RevitAddin.UI.Controls"
        Title="Duct Accessory Numbering"
        Width="520"
        Height="560"
        MinWidth="440"
        MinHeight="500"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HCB.RevitAddin;component/UI/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Duct Accessory Numbering"
                   Style="{StaticResource SectionTitleStyle}" />

        <ScrollViewer Grid.Row="1"
                      Margin="0,16,0,0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Padding="12"
                        Background="#F6F8FB"
                        BorderBrush="#D8E0EC"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabelStyle}"
                                   Text="Jak dziala to narzedzie" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource StatusTextStyle}"
                                   Opacity="0.72"
                                   TextWrapping="Wrap"
                                   Text="narzedzie numeruje tylko Duct Accessory. elementy sa grupowane po ukladzie w obrebie tego samego HC_System i dostaja wspolny numer." />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource StatusTextStyle}"
                                   Opacity="0.72"
                                   TextWrapping="Wrap"
                                   Text="format numeru: TypeMark.HC_System.KolejnyNumer. jesli Type Mark jest pusty, narzedzie uzyje nazwy typu." />
                    </StackPanel>
                </Border>

                <GroupBox Margin="0,16,0,0"
                          Header="Ustawienia numeracji">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionLabelStyle}"
                                       Text="Parametr docelowy"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="TargetParameterComboBox"
                                      Grid.Column="1"
                                      SelectionChanged="OptionsChanged" />
                        </Grid>
                        <TextBlock Margin="0,0,0,12"
                                   Style="{StaticResource StatusTextStyle}"
                                   Opacity="0.62"
                                   TextWrapping="Wrap"
                                   Text="tu zostanie wpisany gotowy numer dla kazdego Duct Accessory." />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionLabelStyle}"
                                       Text="Numer startowy"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="StartNumberTextBox"
                                     Grid.Column="1"
                                     Text="1"
                                     TextChanged="OptionsChanged" />
                        </Grid>
                        <TextBlock Margin="0,0,0,8"
                                   Style="{StaticResource StatusTextStyle}"
                                   Opacity="0.62"
                                   TextWrapping="Wrap"
                                   Text="kolejny numer jest nadawany kazdej nowej grupie ukladu." />
                        <CheckBox x:Name="UseLastProjectNumberCheckBox"
                                  Margin="0,0,0,12"
                                  Content="Pobierz ostatni numer z projektu i zacznij od kolejnego"
                                  Checked="OptionsChanged"
                                  Unchecked="OptionsChanged" />

                        <Border Padding="10"
                                Background="#FAFBFD"
                                BorderBrush="#D8E0EC"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionLabelStyle}"
                                           Text="Preview" />
                                <TextBlock x:Name="PreviewTextBlock"
                                           Margin="0,8,0,0"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource StatusTextStyle}"
                                           Opacity="0.72"
                                           TextWrapping="Wrap"
                                           Text="przyklad: VAV.S1.12 albo Supply_Accessory.W1.12, zaleznie od Type Mark i HC_System." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <controls:DialogFooterBar x:Name="FooterBar"
                                  Grid.Row="2"
                                  Margin="0,16,0,0"
                                  PrimaryButtonText="Numeruj"
                                  SecondaryButtonText="Anuluj"
                                  PrimaryButtonClick="ConfirmButton_OnClick"
                                  SecondaryButtonClick="CancelButton_OnClick" />
    </Grid>
</Window>
