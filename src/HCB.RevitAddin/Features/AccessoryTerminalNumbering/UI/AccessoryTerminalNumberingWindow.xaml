<Window x:Class="HCB.RevitAddin.Features.AccessoryTerminalNumbering.UI.AccessoryTerminalNumberingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HCB.RevitAddin.UI.Controls"
        Title="Duct Accessory Numbering"
        Width="560"
        Height="560"
        MinWidth="480"
        MinHeight="480"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource HcbWindowStyle}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HCB.RevitAddin;component/UI/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Style="{StaticResource DialogRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:DialogHeader Title="Duct Accessory Numbering"
                               Description="Grupuje Duct Accessory po układzie w obrębie tego samego HC_System i nadaje każdej grupie wspólny numer." />

        <ScrollViewer Grid.Row="1"
                      Margin="{StaticResource Space.Section}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource InfoPanelStyle}">
                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Text="Format numeru: TypeMark.HC_System.KolejnyNumer. Jeśli Type Mark jest pusty, narzędzie użyje nazwy typu." />
                </Border>

                <GroupBox Margin="{StaticResource Space.Section}"
                          Header="Ustawienia numeracji">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource FormLabelColumnWidth}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   Text="Parametr docelowy" />
                        <ComboBox x:Name="TargetParameterComboBox"
                                  Grid.Column="1"
                                  SelectionChanged="OptionsChanged" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Margin="{StaticResource Space.Hint}"
                                   Style="{StaticResource HintTextStyle}"
                                   Text="Tu zostanie wpisany gotowy numer dla każdego Duct Accessory." />

                        <TextBlock Grid.Row="2"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Text="Numer startowy" />
                        <TextBox x:Name="StartNumberTextBox"
                                 Grid.Row="2"
                                 Grid.Column="1"
                                 Text="1"
                                 TextChanged="OptionsChanged" />
                        <TextBlock Grid.Row="3"
                                   Grid.Column="1"
                                   Margin="{StaticResource Space.Hint}"
                                   Style="{StaticResource HintTextStyle}"
                                   Text="Kolejny numer jest nadawany każdej nowej grupie układu." />

                        <CheckBox x:Name="UseLastProjectNumberCheckBox"
                                  Grid.Row="4"
                                  Grid.Column="1"
                                  Content="Pobierz ostatni numer z projektu i zacznij od kolejnego"
                                  Checked="OptionsChanged"
                                  Unchecked="OptionsChanged" />
                    </Grid>
                </GroupBox>

                <Border Margin="{StaticResource Space.Section}"
                        Style="{StaticResource PreviewPanelStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabelStyle}"
                                   Text="Podgląd" />
                        <TextBlock x:Name="PreviewTextBlock"
                                   Margin="0,6,0,0"
                                   Style="{StaticResource EmphasisTextStyle}" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource HintTextStyle}"
                                   Text="Przykład: VAV.S1.12 albo Supply_Accessory.W1.12, zależnie od Type Mark i HC_System." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <controls:DialogFooterBar x:Name="FooterBar"
                                  Grid.Row="2"
                                  Margin="{StaticResource Space.Section}"
                                  PrimaryButtonText="Numeruj"
                                  SecondaryButtonText="Anuluj"
                                  PrimaryButtonClick="ConfirmButton_OnClick"
                                  SecondaryButtonClick="CancelButton_OnClick" />
    </Grid>
</Window>
