<Window x:Class="HCB.RevitAddin.Features.TransferViewTemplates.UI.TransferViewTemplatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HCB.RevitAddin.UI.Controls"
        Title="Transfer View Templates"
        Width="680"
        Height="680"
        MinWidth="620"
        MinHeight="560"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource HcbWindowStyle}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HCB.RevitAddin;component/UI/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Style="{StaticResource DialogRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Same layout as controls:DialogHeader; the title TextBlock is kept because code-behind sets HeaderTextBlock.Text. -->
        <StackPanel>
            <TextBlock x:Name="HeaderTextBlock"
                       Style="{StaticResource SectionTitleStyle}"
                       Text="Transfer View Templates" />
            <TextBlock Style="{StaticResource WindowDescriptionStyle}"
                       Text="Kopiuje wybrane szablony z jednego otwartego projektu do drugiego." />
            <Border Margin="0,12,0,0"
                    Style="{StaticResource DividerStyle}" />
        </StackPanel>

        <GroupBox Grid.Row="1"
                  Margin="{StaticResource Space.Section}"
                  Header="Projekty">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource FormLabelColumnWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource FieldLabelStyle}"
                           Margin="0,0,12,8"
                           Text="Kopiuj z" />
                <ComboBox x:Name="SourceDocumentComboBox"
                          Grid.Column="1"
                          Margin="{StaticResource Space.Field}"
                          SelectionChanged="DocumentComboBox_OnSelectionChanged" />
                <TextBlock Grid.Row="1"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,0,12,8"
                           Text="Wklej do" />
                <ComboBox x:Name="TargetDocumentComboBox"
                          Grid.Row="1"
                          Grid.Column="1"
                          Margin="{StaticResource Space.Field}"
                          SelectionChanged="DocumentComboBox_OnSelectionChanged" />
                <CheckBox x:Name="OverrideExistingCheckBox"
                          Grid.Row="2"
                          Grid.Column="1"
                          Content="Nadpisuj szablony o tej samej nazwie w projekcie docelowym" />
            </Grid>
        </GroupBox>

        <GroupBox x:Name="TemplatesGroupBox"
                  Grid.Row="2"
                  Margin="{StaticResource Space.Section}"
                  Header="Szablony widoków">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top"
                           Margin="0,0,0,4"
                           Style="{StaticResource SectionLabelStyle}"
                           Text="Szukaj" />
                <TextBox x:Name="SearchTextBox"
                         DockPanel.Dock="Top"
                         Margin="{StaticResource Space.Field}"
                         TextChanged="SearchTextBox_OnTextChanged" />
                <controls:SelectionActionsBar DockPanel.Dock="Top"
                                              Margin="0,0,0,8"
                                              LeftButtonText="Wszystkie"
                                              RightButtonText="Brak"
                                              LeftButtonClick="SelectAllButton_OnClick"
                                              RightButtonClick="SelectNoneButton_OnClick" />
                <ListBox x:Name="TemplatesListBox"
                         DisplayMemberPath="Name"
                         SelectionMode="Extended" />
            </DockPanel>
        </GroupBox>

        <controls:DialogFooterBar x:Name="FooterBar"
                                  Grid.Row="3"
                                  Margin="{StaticResource Space.Section}"
                                  PrimaryButtonText="Transferuj"
                                  SecondaryButtonText="Anuluj"
                                  PrimaryButtonClick="ConfirmButton_OnClick"
                                  SecondaryButtonClick="CancelButton_OnClick" />
    </Grid>
</Window>
