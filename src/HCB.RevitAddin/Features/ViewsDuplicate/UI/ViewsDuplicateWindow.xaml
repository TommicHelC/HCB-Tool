<Window x:Class="HCB.RevitAddin.Features.ViewsDuplicate.UI.ViewsDuplicateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HCB.RevitAddin.UI.Controls"
        Title="Duplicate Views"
        Width="480"
        Height="340"
        MinWidth="440"
        MinHeight="320"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource HcbWindowStyle}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HCB.RevitAddin;component/UI/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Style="{StaticResource DialogRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:DialogHeader Title="Duplicate Views"
                               Description="Tworzy wskazaną liczbę kopii zaznaczonych widoków." />

        <GroupBox Grid.Row="1"
                  Margin="{StaticResource Space.Section}"
                  VerticalAlignment="Top"
                  Header="Ustawienia duplikacji">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource FormLabelColumnWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource FieldLabelStyle}"
                           Margin="0,0,12,8"
                           Text="Liczba kopii" />
                <TextBox x:Name="CopiesCountTextBox"
                         Grid.Column="1"
                         Width="80"
                         Margin="{StaticResource Space.Field}"
                         HorizontalAlignment="Left"
                         Text="1" />
                <TextBlock Grid.Row="1"
                           Style="{StaticResource FieldLabelStyle}"
                           Text="Tryb duplikacji" />
                <!-- Item Content values are read by code-behind as the duplicate mode - do not translate. -->
                <ComboBox x:Name="DuplicateModeComboBox"
                          Grid.Row="1"
                          Grid.Column="1"
                          SelectedIndex="1">
                    <ComboBoxItem Content="Duplicate" />
                    <ComboBoxItem Content="WithDetailing" />
                    <ComboBoxItem Content="AsDependent" />
                </ComboBox>
            </Grid>
        </GroupBox>

        <controls:DialogFooterBar x:Name="FooterBar"
                                  Grid.Row="2"
                                  Margin="{StaticResource Space.Section}"
                                  PrimaryButtonText="Duplikuj widoki"
                                  SecondaryButtonText="Anuluj"
                                  PrimaryButtonClick="ConfirmButton_OnClick"
                                  SecondaryButtonClick="CancelButton_OnClick" />
    </Grid>
</Window>
