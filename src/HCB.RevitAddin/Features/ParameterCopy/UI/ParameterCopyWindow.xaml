<Window x:Class="HCB.RevitAddin.Features.ParameterCopy.UI.ParameterCopyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HCB.RevitAddin.UI.Controls"
        Title="Copy Parameter"
        Width="620"
        Height="440"
        MinWidth="520"
        MinHeight="400"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource HcbWindowStyle}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HCB.RevitAddin;component/UI/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Style="{StaticResource DialogRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:DialogHeader Title="Copy Parameter"
                               Description="Kopiuje wartość parametru źródłowego do parametru docelowego w elementach instalacji." />

        <StackPanel Grid.Row="1"
                    Margin="{StaticResource Space.Section}">
            <GroupBox Header="Ustawienia kopiowania">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource FormLabelColumnWidth}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                               Text="Zakres" />
                    <ComboBox x:Name="ScopeComboBox"
                              Grid.Column="1"
                              Margin="{StaticResource Space.Field}"
                              SelectionChanged="ScopeComboBox_OnSelectionChanged" />

                    <TextBlock Grid.Row="1"
                               Style="{StaticResource FieldLabelStyle}"
                               Text="Parametr źródłowy" />
                    <ComboBox x:Name="SourceParameterComboBox"
                              Grid.Row="1"
                              Grid.Column="1"
                              Margin="{StaticResource Space.Field}"
                              SelectionChanged="SourceParameterComboBox_OnSelectionChanged" />

                    <TextBlock Grid.Row="2"
                               Style="{StaticResource FieldLabelStyle}"
                               Text="Parametr docelowy" />
                    <ComboBox x:Name="TargetParameterComboBox"
                              Grid.Row="2"
                              Grid.Column="1"
                              SelectionChanged="TargetParameterComboBox_OnSelectionChanged" />

                    <TextBlock Grid.Row="3"
                               Grid.Column="1"
                               Margin="{StaticResource Space.Hint}"
                               Style="{StaticResource HintTextStyle}"
                               Text="Lista docelowa jest ograniczona do zapisywalnych parametrów zgodnych typem danych z wybranym parametrem źródłowym." />
                </Grid>
            </GroupBox>

            <Border Margin="{StaticResource Space.Section}"
                    Style="{StaticResource PreviewPanelStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabelStyle}"
                               Text="Podgląd" />
                    <TextBlock x:Name="PreviewTextBlock"
                               Margin="0,6,0,0"
                               Style="{StaticResource EmphasisTextStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <controls:DialogFooterBar x:Name="FooterBar"
                                  Grid.Row="2"
                                  Margin="{StaticResource Space.Section}"
                                  PrimaryButtonText="Kopiuj wartości"
                                  SecondaryButtonText="Anuluj"
                                  PrimaryButtonClick="ConfirmButton_OnClick"
                                  SecondaryButtonClick="CancelButton_OnClick" />
    </Grid>
</Window>
