<Window x:Class="HCB.RevitAddin.Features.ParameterClear.UI.ParameterClearWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HCB.RevitAddin.UI.Controls"
        Title="Clear Parameter"
        Width="580"
        Height="300"
        MinWidth="540"
        MinHeight="260"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HCB.RevitAddin;component/UI/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Czyszczenie wartosci parametru"
                   Style="{StaticResource SectionTitleStyle}" />

        <GroupBox Grid.Row="1"
                  Margin="0,16,0,0"
                  Header="Zakres">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.ColumnSpan="2"
                           Text="{Binding ScopeDescription}"
                           Style="{StaticResource StatusTextStyle}"
                           TextWrapping="Wrap" />

                <TextBlock x:Name="ScopeLabelTextBlock"
                           Grid.Row="2"
                           Style="{StaticResource SectionLabelStyle}"
                           Text="Tryb"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="ScopeComboBox"
                          Grid.Row="2"
                          Grid.Column="1"
                          SelectionChanged="ScopeComboBox_OnSelectionChanged" />

                <TextBlock x:Name="CategoryLabelTextBlock"
                           Grid.Row="4"
                           Style="{StaticResource SectionLabelStyle}"
                           Text="Kategoria"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="CategoryComboBox"
                          Grid.Row="4"
                          Grid.Column="1"
                          SelectionChanged="CategoryComboBox_OnSelectionChanged" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2"
                  Margin="0,16,0,0"
                  Header="Parametr">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Style="{StaticResource SectionLabelStyle}"
                           Text="Parametr do wyczyszczenia"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="ParameterComboBox"
                          Grid.Column="1" />
            </Grid>
        </GroupBox>

        <controls:DialogFooterBar x:Name="FooterBar"
                                  Grid.Row="4"
                                  Margin="0,16,0,0"
                                  PrimaryButtonText="Wyczysc parametr"
                                  SecondaryButtonText="Anuluj"
                                  PrimaryButtonClick="ConfirmButton_OnClick"
                                  SecondaryButtonClick="CancelButton_OnClick" />
    </Grid>
</Window>
