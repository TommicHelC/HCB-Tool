<Window x:Class="HCB.RevitAddin.Features.ParameterClear.UI.ParameterClearWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HCB.RevitAddin.UI.Controls"
        Title="Clear Parameter"
        Width="580"
        Height="450"
        MinWidth="500"
        MinHeight="430"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource HcbWindowStyle}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HCB.RevitAddin;component/UI/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Style="{StaticResource DialogRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:DialogHeader Title="Clear Parameter"
                               Description="Czyści wartość wybranego parametru w zaznaczonych elementach, kategorii lub całym modelu." />

        <StackPanel Grid.Row="1"
                    Margin="{StaticResource Space.Section}">
            <GroupBox Header="Zakres">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource FormLabelColumnWidth}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.ColumnSpan="2"
                            Margin="{StaticResource Space.Field}"
                            Style="{StaticResource InfoPanelStyle}">
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Text="{Binding ScopeDescription}" />
                    </Border>

                    <TextBlock x:Name="ScopeLabelTextBlock"
                               Grid.Row="1"
                               Style="{StaticResource FieldLabelStyle}"
                               Text="Tryb" />
                    <ComboBox x:Name="ScopeComboBox"
                              Grid.Row="1"
                              Grid.Column="1"
                              SelectionChanged="ScopeComboBox_OnSelectionChanged" />

                    <TextBlock x:Name="CategoryLabelTextBlock"
                               Grid.Row="2"
                               Margin="0,8,12,0"
                               Style="{StaticResource FieldLabelStyle}"
                               Text="Kategoria" />
                    <ComboBox x:Name="CategoryComboBox"
                              Grid.Row="2"
                              Grid.Column="1"
                              Margin="0,8,0,0"
                              SelectionChanged="CategoryComboBox_OnSelectionChanged" />
                </Grid>
            </GroupBox>

            <GroupBox Margin="{StaticResource Space.Section}"
                      Header="Parametr">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource FormLabelColumnWidth}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                               Text="Parametr do wyczyszczenia" />
                    <ComboBox x:Name="ParameterComboBox"
                              Grid.Column="1" />
                </Grid>
            </GroupBox>
        </StackPanel>

        <controls:DialogFooterBar x:Name="FooterBar"
                                  Grid.Row="2"
                                  Margin="{StaticResource Space.Section}"
                                  PrimaryButtonText="Wyczyść parametr"
                                  SecondaryButtonText="Anuluj"
                                  PrimaryButtonClick="ConfirmButton_OnClick"
                                  SecondaryButtonClick="CancelButton_OnClick" />
    </Grid>
</Window>
