<Window x:Class="HCB.RevitAddin.Features.BatchAddSharedFamilyParameters.UI.BatchAddSharedFamilyParametersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HCB.RevitAddin.UI.Controls"
        Title="Add Shared Family Parameters"
        Width="720"
        Height="700"
        MinWidth="640"
        MinHeight="620"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource HcbWindowStyle}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HCB.RevitAddin;component/UI/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Style="{StaticResource DialogRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:DialogHeader Title="Add Shared Family Parameters"
                               Description="Dodaje wybrane parametry współdzielone do wielu rodzin naraz." />

        <GroupBox Grid.Row="1"
                  Margin="{StaticResource Space.Section}"
                  Header="Plik źródłowy">
            <TextBox x:Name="SharedParameterFileTextBox"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     MinHeight="52" />
        </GroupBox>

        <GroupBox Grid.Row="2"
                  Margin="{StaticResource Space.Section}"
                  Header="Parametry do dodania">
            <DockPanel LastChildFill="True">
                <controls:SelectionActionsBar DockPanel.Dock="Top"
                                              Margin="0,0,0,8"
                                              LeftButtonText="Wszystkie"
                                              RightButtonText="Brak"
                                              LeftButtonClick="SelectAllButton_OnClick"
                                              RightButtonClick="SelectNoneButton_OnClick" />
                <ListBox x:Name="ParametersListBox"
                         DisplayMemberPath="DisplayName"
                         SelectionMode="Extended" />
            </DockPanel>
        </GroupBox>

        <GroupBox Grid.Row="3"
                  Margin="{StaticResource Space.Section}"
                  Header="Ustawienia dodawania">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource FormLabelColumnWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource FieldLabelStyle}"
                           Margin="0,0,12,8"
                           Text="Tryb parametru" />
                <CheckBox x:Name="InstanceCheckBox"
                          Grid.Column="1"
                          Margin="{StaticResource Space.Field}"
                          Content="Dodaj jako Instance" />

                <TextBlock Grid.Row="1"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,0,12,8"
                           Text="Grupa parametru" />
                <ComboBox x:Name="GroupComboBox"
                          Grid.Row="1"
                          Grid.Column="1"
                          Margin="{StaticResource Space.Field}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Key" />

                <TextBlock Grid.Row="2"
                           Style="{StaticResource FieldLabelStyle}"
                           VerticalAlignment="Top"
                           Text="Zapis rodzin" />
                <StackPanel Grid.Row="2"
                            Grid.Column="1">
                    <CheckBox x:Name="SaveAsCopyCheckBox"
                              Content="Zapisz jako kopie do wskazanego folderu"
                              IsChecked="True"
                              Checked="SaveAsCopyCheckBox_OnChanged"
                              Unchecked="SaveAsCopyCheckBox_OnChanged" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="OutputFolderTextBox"
                                 IsReadOnly="True"
                                 VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="Wybierz folder…"
                                Click="BrowseOutputFolderButton_OnClick" />
                    </Grid>
                </StackPanel>
            </Grid>
        </GroupBox>

        <controls:DialogFooterBar x:Name="FooterBar"
                                  Grid.Row="4"
                                  Margin="{StaticResource Space.Section}"
                                  PrimaryButtonText="Dodaj parametry"
                                  SecondaryButtonText="Anuluj"
                                  PrimaryButtonClick="ConfirmButton_OnClick"
                                  SecondaryButtonClick="CancelButton_OnClick" />
    </Grid>
</Window>
