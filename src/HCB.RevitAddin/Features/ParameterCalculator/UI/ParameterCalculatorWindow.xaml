<Window x:Class="HCB.RevitAddin.Features.ParameterCalculator.UI.ParameterCalculatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HCB.RevitAddin.UI.Controls"
        Title="Parameter Calculator"
        Width="760"
        Height="620"
        MinWidth="640"
        MinHeight="560"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource HcbWindowStyle}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HCB.RevitAddin;component/UI/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Style="{StaticResource DialogRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:DialogHeader Title="Parameter Calculator"
                               Description="Oblicza wartość parametru docelowego z formuły złożonej z parametrów źródłowych." />

        <Grid Grid.Row="1"
              Margin="{StaticResource Space.Section}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <GroupBox Header="Zakres i wynik">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource FormLabelColumnWidth}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.ColumnSpan="2"
                            Margin="{StaticResource Space.Field}"
                            Style="{StaticResource InfoPanelStyle}">
                        <TextBlock x:Name="ScopeTextBlock"
                                   Style="{StaticResource HintTextStyle}" />
                    </Border>

                    <TextBlock Grid.Row="1"
                               Style="{StaticResource FieldLabelStyle}"
                               Text="Parametr docelowy" />
                    <ComboBox x:Name="TargetParameterComboBox"
                              Grid.Row="1"
                              Grid.Column="1"
                              Margin="{StaticResource Space.Field}"
                              SelectionChanged="OptionChanged" />

                    <TextBlock Grid.Row="2"
                               Style="{StaticResource FieldLabelStyle}"
                               Text="Liczba miejsc po przecinku" />
                    <TextBox x:Name="DecimalPlacesTextBox"
                             Grid.Row="2"
                             Grid.Column="1"
                             Width="72"
                             HorizontalAlignment="Left"
                             TextChanged="OptionChanged" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="1"
                      Margin="{StaticResource Space.Section}"
                      Header="Formuła">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Bottom"
                               Margin="0,8,0,0"
                               Orientation="Horizontal">
                        <Button Style="{StaticResource InlineActionButtonStyle}"
                                Content="Dodaj parametr"
                                Click="AddRowButton_OnClick" />
                        <Button Margin="6,0,0,0"
                                Style="{StaticResource InlineActionButtonStyle}"
                                Content="Usuń parametr"
                                Click="RemoveRowButton_OnClick" />
                        <Button Margin="6,0,0,0"
                                Style="{StaticResource InlineActionButtonStyle}"
                                Content="W górę"
                                Click="MoveUpButton_OnClick" />
                        <Button Margin="6,0,0,0"
                                Style="{StaticResource InlineActionButtonStyle}"
                                Content="W dół"
                                Click="MoveDownButton_OnClick" />
                    </WrapPanel>

                    <DataGrid x:Name="OperandsDataGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              ItemsSource="{Binding Operands}"
                              SelectionMode="Single"
                              CellEditEnding="OperandsDataGrid_OnCellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Operator" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding OperatorSymbol}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.OperatorOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding OperatorSymbol, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Parametr" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ParameterName}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.AvailableParameterNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding ParameterName, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>

            <Border Grid.Row="2"
                    Margin="{StaticResource Space.Section}"
                    Style="{StaticResource PreviewPanelStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabelStyle}"
                               Text="Podgląd" />
                    <TextBlock x:Name="PreviewTextBlock"
                               Margin="0,6,0,0"
                               Style="{StaticResource EmphasisTextStyle}" />
                </StackPanel>
            </Border>
        </Grid>

        <controls:DialogFooterBar x:Name="FooterBar"
                                  Grid.Row="2"
                                  Margin="{StaticResource Space.Section}"
                                  PrimaryButtonText="Oblicz"
                                  SecondaryButtonText="Anuluj"
                                  PrimaryButtonClick="ConfirmButton_OnClick"
                                  SecondaryButtonClick="CancelButton_OnClick" />
    </Grid>
</Window>
