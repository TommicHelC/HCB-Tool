<Window x:Class="HCB.RevitAddin.Features.ParameterCalculator.UI.ParameterCalculatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HCB.RevitAddin.UI.Controls"
        Title="Parameter Calculator"
        Width="760"
        Height="560"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HCB.RevitAddin;component/UI/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Parameter Calculator"
                   Style="{StaticResource SectionTitleStyle}" />

        <GroupBox Grid.Row="1"
                  Margin="0,16,0,12"
                  Header="Zakres i wynik">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ScopeTextBlock"
                           Grid.Row="0"
                           Grid.ColumnSpan="3"
                           TextWrapping="Wrap"
                           Style="{StaticResource StatusTextStyle}" />

                <TextBlock Grid.Row="2"
                           Style="{StaticResource SectionLabelStyle}"
                           Text="Parametr docelowy"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="TargetParameterComboBox"
                          Grid.Row="2"
                          Grid.Column="1"
                          Margin="0,0,8,0"
                          SelectionChanged="OptionChanged" />

                <TextBlock Grid.Row="2"
                           Grid.Column="2"
                           Margin="8,0,0,0"
                           Style="{StaticResource SectionLabelStyle}"
                           Text="Liczba miejsc po przecinku"
                           VerticalAlignment="Center" />
                <TextBox x:Name="DecimalPlacesTextBox"
                         Grid.Row="4"
                         Grid.Column="2"
                         Margin="8,0,0,0"
                         Width="72"
                         HorizontalAlignment="Left"
                         TextChanged="OptionChanged" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2"
                  Header="Formula">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid x:Name="OperandsDataGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          ItemsSource="{Binding Operands}"
                          SelectionMode="Single"
                          CellEditEnding="OperandsDataGrid_OnCellEditEnding">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Operator" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding OperatorSymbol}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.OperatorOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding OperatorSymbol, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Parametr" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ParameterName}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.AvailableParameterNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding ParameterName, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1"
                            Margin="0,12,0,0"
                            Orientation="Horizontal">
                    <Button Width="120"
                            Margin="0,0,8,0"
                            Content="Dodaj parametr"
                            Click="AddRowButton_OnClick" />
                    <Button Width="120"
                            Margin="0,0,8,0"
                            Content="Usun parametr"
                            Click="RemoveRowButton_OnClick" />
                    <Button Width="96"
                            Margin="0,0,8,0"
                            Content="W gore"
                            Click="MoveUpButton_OnClick" />
                    <Button Width="96"
                            Content="W dol"
                            Click="MoveDownButton_OnClick" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3"
                  Margin="0,12,0,0"
                  Header="Podglad">
            <TextBlock x:Name="PreviewTextBlock"
                       TextWrapping="Wrap"
                       Style="{StaticResource StatusTextStyle}" />
        </GroupBox>

        <controls:DialogFooterBar x:Name="FooterBar"
                                  Grid.Row="4"
                                  Margin="0,16,0,0"
                                  PrimaryButtonText="Oblicz"
                                  SecondaryButtonText="Anuluj"
                                  PrimaryButtonClick="ConfirmButton_OnClick"
                                  SecondaryButtonClick="CancelButton_OnClick" />
    </Grid>
</Window>
