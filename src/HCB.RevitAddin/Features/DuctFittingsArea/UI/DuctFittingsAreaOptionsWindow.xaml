<Window x:Class="HCB.RevitAddin.Features.DuctFittingsArea.UI.DuctFittingsAreaOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HCB.RevitAddin.UI.Controls"
        Title="Ustawienia HC Area"
        Width="540"
        Height="340"
        MinWidth="480"
        MinHeight="320"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource HcbWindowStyle}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HCB.RevitAddin;component/UI/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Style="{StaticResource DialogRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:DialogHeader Title="Ustawienia HC Area"
                               Description="Zapisuje powierzchnię kanałów i kształtek w parametrze HC_Area." />

        <GroupBox Grid.Row="1"
                  Margin="{StaticResource Space.Section}"
                  VerticalAlignment="Top"
                  Header="Wartości poniżej 1 m²">
            <StackPanel>
                <RadioButton x:Name="KeepRealValuesRadioButton"
                             Margin="{StaticResource Space.Field}"
                             Content="Zostaw realne wartości z obliczeń i kopiowania"
                             IsChecked="True" />
                <RadioButton x:Name="ClampToOneRadioButton"
                             Content="Ustaw minimum 1 m² dla wartości poniżej 1" />
                <TextBlock Margin="0,10,0,0"
                           Style="{StaticResource HintTextStyle}"
                           Text="Opcja dotyczy zarówno kształtek liczonych geometrycznie, jak i kanałów kopiowanych z natywnej powierzchni Revit." />
            </StackPanel>
        </GroupBox>

        <controls:DialogFooterBar x:Name="FooterBar"
                                  Grid.Row="2"
                                  Margin="{StaticResource Space.Section}"
                                  PrimaryButtonText="Uruchom"
                                  SecondaryButtonText="Anuluj"
                                  PrimaryButtonClick="ConfirmButton_OnClick"
                                  SecondaryButtonClick="CancelButton_OnClick"
                                  StatusText="Wybierz sposób zapisu wartości do HC_Area." />
    </Grid>
</Window>
