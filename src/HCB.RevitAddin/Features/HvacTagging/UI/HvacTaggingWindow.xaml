<Window x:Class="HCB.RevitAddin.Features.HvacTagging.UI.HvacTaggingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HCB.RevitAddin.UI.Controls"
        Title="HVAC Tags"
        Width="980"
        Height="720"
        MinWidth="860"
        MinHeight="620"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource HcbWindowStyle}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HCB.RevitAddin;component/UI/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Style="{StaticResource DialogRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:DialogHeader Title="HVAC Tags"
                               Description="Tworzy tagi elementów HVAC w aktywnym widoku lub na widokach aktywnego arkusza." />

        <GroupBox Grid.Row="1"
                  Margin="{StaticResource Space.Section}"
                  Header="Ustawienia tagowania">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ItemsControl x:Name="RulesItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="{StaticResource Space.Field}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource FormLabelColumnWidth}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{Binding DisplayName}" />

                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableTagTypes}"
                                          SelectedItem="{Binding SelectedTagType, Mode=TwoWay}"
                                          SelectionChanged="TagTypeComboBox_OnSelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <Run Text="{Binding FamilyName}" />
                                                <Run Text=": " />
                                                <Run Text="{Binding Name}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Margin="0,0,12,8"
                               Style="{StaticResource FieldLabelStyle}"
                               Text="Offset X [mm]" />
                    <TextBox x:Name="OffsetXTextBox"
                             Grid.Row="0"
                             Grid.Column="1"
                             Margin="{StaticResource Space.Field}"
                             Text="0"
                             TextChanged="Options_OnChanged" />

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Margin="0,0,12,8"
                               Style="{StaticResource FieldLabelStyle}"
                               Text="Offset Y [mm]" />
                    <TextBox x:Name="OffsetYTextBox"
                             Grid.Row="1"
                             Grid.Column="1"
                             Margin="{StaticResource Space.Field}"
                             Text="0"
                             TextChanged="Options_OnChanged" />

                    <CheckBox x:Name="UseLeaderCheckBox"
                              Grid.Row="2"
                              Grid.Column="1"
                              Content="Użyj linii odniesienia (leader)"
                              Checked="Options_OnChanged"
                              Unchecked="Options_OnChanged" />

                    <Border Grid.Row="3"
                            Grid.ColumnSpan="2"
                            Margin="{StaticResource Space.Section}"
                            Style="{StaticResource InfoPanelStyle}">
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Text="Zakres: aktywny widok albo viewporty aktywnego arkusza. Elementy z istniejącym tagiem nie będą dublowane." />
                    </Border>
                </Grid>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2"
                  Margin="{StaticResource Space.Section}"
                  Header="Podgląd">
            <DataGrid x:Name="PreviewDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Extended">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        Width="92" />
                    <DataGridTextColumn Header="Widok"
                                        Binding="{Binding ViewName}"
                                        Width="1.4*" />
                    <DataGridTextColumn Header="Kategoria"
                                        Binding="{Binding CategoryName}"
                                        Width="1.1*" />
                    <DataGridTextColumn Header="Element"
                                        Binding="{Binding ElementName}"
                                        Width="1.5*" />
                    <DataGridTextColumn Header="Id"
                                        Binding="{Binding ElementIdText}"
                                        Width="78" />
                    <DataGridTextColumn Header="Komunikat"
                                        Binding="{Binding Message}"
                                        Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <controls:DialogFooterBar x:Name="FooterBar"
                                  Grid.Row="3"
                                  Margin="{StaticResource Space.Section}"
                                  PrimaryButtonText="Utwórz tagi"
                                  SecondaryButtonText="Anuluj"
                                  PrimaryButtonClick="CreateTagsButton_OnClick"
                                  SecondaryButtonClick="CancelButton_OnClick" />
    </Grid>
</Window>
