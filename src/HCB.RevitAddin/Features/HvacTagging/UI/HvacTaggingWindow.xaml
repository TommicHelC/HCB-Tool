<Window x:Class="HCB.RevitAddin.Features.HvacTagging.UI.HvacTaggingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HCB.RevitAddin.UI.Controls"
        Title="HVAC Tags"
        Width="980"
        Height="720"
        MinWidth="860"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HCB.RevitAddin;component/UI/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="HVAC Tags"
                   Style="{StaticResource SectionTitleStyle}" />

        <GroupBox Grid.Row="1"
                  Margin="0,14,0,0"
                  Header="Ustawienia tagowania">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ItemsControl x:Name="RulesItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource SectionLabelStyle}"
                                           Text="{Binding DisplayName}"
                                           VerticalAlignment="Center" />

                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableTagTypes}"
                                          SelectedItem="{Binding SelectedTagType, Mode=TwoWay}"
                                          SelectionChanged="TagTypeComboBox_OnSelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <Run Text="{Binding FamilyName}" />
                                                <Run Text=": " />
                                                <Run Text="{Binding Name}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Style="{StaticResource SectionLabelStyle}"
                               Text="Offset X [mm]"
                               VerticalAlignment="Center" />
                    <TextBox x:Name="OffsetXTextBox"
                             Grid.Row="0"
                             Grid.Column="1"
                             Text="0"
                             TextChanged="Options_OnChanged" />

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Style="{StaticResource SectionLabelStyle}"
                               Text="Offset Y [mm]"
                               VerticalAlignment="Center" />
                    <TextBox x:Name="OffsetYTextBox"
                             Grid.Row="2"
                             Grid.Column="1"
                             Text="0"
                             TextChanged="Options_OnChanged" />

                    <CheckBox x:Name="UseLeaderCheckBox"
                              Grid.Row="4"
                              Grid.ColumnSpan="2"
                              Content="Use leader"
                              Checked="Options_OnChanged"
                              Unchecked="Options_OnChanged" />

                    <TextBlock Grid.Row="6"
                               Grid.ColumnSpan="2"
                               Style="{StaticResource StatusTextStyle}"
                               TextWrapping="Wrap"
                               Text="Zakres: aktywny widok albo viewporty aktywnego arkusza. Elementy z istniejacym tagiem nie beda dublowane." />
                </Grid>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2"
                  Margin="0,14,0,0"
                  Header="Preview">
            <DataGrid x:Name="PreviewDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      SelectionMode="Extended">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        Width="92" />
                    <DataGridTextColumn Header="Widok"
                                        Binding="{Binding ViewName}"
                                        Width="1.4*" />
                    <DataGridTextColumn Header="Kategoria"
                                        Binding="{Binding CategoryName}"
                                        Width="1.1*" />
                    <DataGridTextColumn Header="Element"
                                        Binding="{Binding ElementName}"
                                        Width="1.5*" />
                    <DataGridTextColumn Header="Id"
                                        Binding="{Binding ElementIdText}"
                                        Width="78" />
                    <DataGridTextColumn Header="Komunikat"
                                        Binding="{Binding Message}"
                                        Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <controls:DialogFooterBar x:Name="FooterBar"
                                  Grid.Row="3"
                                  Margin="0,16,0,0"
                                  PrimaryButtonText="Utworz tagi"
                                  SecondaryButtonText="Anuluj"
                                  PrimaryButtonClick="CreateTagsButton_OnClick"
                                  SecondaryButtonClick="CancelButton_OnClick" />
    </Grid>
</Window>
