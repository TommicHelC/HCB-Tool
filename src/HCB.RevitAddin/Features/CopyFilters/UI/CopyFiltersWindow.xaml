<Window x:Class="HCB.RevitAddin.Features.CopyFilters.UI.CopyFiltersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HCB.RevitAddin.UI.Controls"
        Title="Kopiowanie filtrów widoku"
        Width="960"
        Height="620"
        MinWidth="820"
        MinHeight="520"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource HcbWindowStyle}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HCB.RevitAddin;component/UI/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Style="{StaticResource DialogRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:DialogHeader Title="Kopiowanie filtrów widoku"
                               Description="Kopiuje wybrane filtry z widoku lub szablonu źródłowego do widoków i szablonów docelowych." />

        <Grid Grid.Row="1"
              Margin="{StaticResource Space.Section}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.4*" MinWidth="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1.6*" MinWidth="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2.4*" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="1. Widok lub szablon źródłowy">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,0,0,4"
                               Style="{StaticResource SectionLabelStyle}"
                               Text="Szukaj" />
                    <TextBox x:Name="SourceSearchTextBox"
                             DockPanel.Dock="Top"
                             Margin="{StaticResource Space.Field}"
                             ToolTip="Filtruj widoki po nazwie."
                             TextChanged="SourceSearchTextBox_OnTextChanged" />
                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,0,0,4"
                               Style="{StaticResource SectionLabelStyle}"
                               Text="Rodzaj widoku" />
                    <ComboBox x:Name="SourceViewTypeComboBox"
                              DockPanel.Dock="Top"
                              Margin="{StaticResource Space.Field}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Value"
                              SelectionChanged="SourceFilters_OnSelectionChanged" />
                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,0,0,4"
                               Style="{StaticResource SectionLabelStyle}"
                               Text="Typ" />
                    <ComboBox x:Name="SourceTypeComboBox"
                              DockPanel.Dock="Top"
                              Margin="{StaticResource Space.Field}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Value"
                              SelectionChanged="SourceFilters_OnSelectionChanged" />
                    <CheckBox x:Name="SourceActiveViewCheckBox"
                              DockPanel.Dock="Top"
                              Margin="{StaticResource Space.Field}"
                              Content="Aktywny widok"
                              Visibility="Collapsed"
                              Checked="SourceActiveViewCheckBox_OnChecked"
                              Unchecked="SourceActiveViewCheckBox_OnUnchecked" />
                    <ListBox x:Name="SourceViewsListBox"
                             DisplayMemberPath="DisplayName"
                             SelectionChanged="SourceViewsListBox_OnSelectionChanged" />
                </DockPanel>
            </GroupBox>

            <GridSplitter Grid.Column="1"
                          Style="{StaticResource SplitterStyle}" />

            <GroupBox Grid.Column="2"
                      Header="2. Filtry">
                <DockPanel LastChildFill="True">
                    <controls:SelectionActionsBar DockPanel.Dock="Top"
                                                  Margin="0,0,0,8"
                                                  LeftButtonText="Wszystkie"
                                                  RightButtonText="Brak"
                                                  LeftButtonClick="SelectAllFiltersButton_OnClick"
                                                  RightButtonClick="ClearFiltersButton_OnClick" />
                    <ListBox x:Name="FiltersListBox"
                             DisplayMemberPath="Name"
                             SelectionMode="Extended" />
                </DockPanel>
            </GroupBox>

            <GridSplitter Grid.Column="3"
                          Style="{StaticResource SplitterStyle}" />

            <GroupBox Grid.Column="4"
                      Header="3. Widoki lub szablony docelowe">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,0,0,4"
                               Style="{StaticResource SectionLabelStyle}"
                               Text="Szukaj" />
                    <TextBox x:Name="DestinationSearchTextBox"
                             DockPanel.Dock="Top"
                             Margin="{StaticResource Space.Field}"
                             ToolTip="Filtruj widoki po nazwie."
                             TextChanged="DestinationSearchTextBox_OnTextChanged" />
                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,0,0,4"
                               Style="{StaticResource SectionLabelStyle}"
                               Text="Rodzaj widoku" />
                    <ComboBox x:Name="DestinationViewTypeComboBox"
                              DockPanel.Dock="Top"
                              Margin="{StaticResource Space.Field}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Value"
                              SelectionChanged="DestinationFilters_OnSelectionChanged" />
                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,0,0,4"
                               Style="{StaticResource SectionLabelStyle}"
                               Text="Typ" />
                    <ComboBox x:Name="DestinationTypeComboBox"
                              DockPanel.Dock="Top"
                              Margin="{StaticResource Space.Field}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Value"
                              SelectionChanged="DestinationFilters_OnSelectionChanged" />
                    <CheckBox x:Name="DestinationActiveViewCheckBox"
                              DockPanel.Dock="Top"
                              Margin="{StaticResource Space.Field}"
                              Content="Aktywny widok"
                              Visibility="Collapsed"
                              Checked="DestinationActiveViewCheckBox_OnChecked"
                              Unchecked="DestinationActiveViewCheckBox_OnUnchecked" />
                    <controls:SelectionActionsBar DockPanel.Dock="Top"
                                                  Margin="0,0,0,8"
                                                  LeftButtonText="Wszystkie"
                                                  RightButtonText="Brak"
                                                  LeftButtonClick="SelectAllDestinationsButton_OnClick"
                                                  RightButtonClick="ClearDestinationsButton_OnClick" />
                    <ListBox x:Name="DestinationViewsListBox"
                             DisplayMemberPath="DisplayName"
                             SelectionMode="Extended" />
                </DockPanel>
            </GroupBox>
        </Grid>

        <controls:DialogFooterBar x:Name="FooterBar"
                                  Grid.Row="2"
                                  Margin="{StaticResource Space.Section}"
                                  PrimaryButtonText="Kopiuj filtry"
                                  SecondaryButtonText="Anuluj"
                                  PrimaryButtonClick="CopyButton_OnClick"
                                  SecondaryButtonClick="CancelButton_OnClick" />
    </Grid>
</Window>
