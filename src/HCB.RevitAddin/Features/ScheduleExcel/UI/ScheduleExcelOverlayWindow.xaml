<Window x:Class="HCB.RevitAddin.Features.ScheduleExcel.UI.ScheduleExcelOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HCB Excel Sync"
        Width="340"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HCB.RevitAddin;component/UI/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Semi-transparent status card shown over Excel while a sync session runs. -->
    <Border Opacity="0.94"
            Padding="12,10"
            CornerRadius="6"
            Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.Accent}"
            BorderThickness="2">
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Margin="6,0,0,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="Stop"
                        ToolTip="Zakończ synchronizację (plik zostaje)."
                        Click="StopButton_OnClick" />
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="Log"
                        ToolTip="Otwórz log synchronizacji."
                        Click="LogButton_OnClick" />
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource SectionTitleStyle}"
                           Text="Synchronizacja z Revit" />
            </DockPanel>
            <TextBlock x:Name="ScheduleText"
                       Margin="0,4,0,0"
                       Style="{StaticResource HintTextStyle}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="StatusText"
                       Margin="0,6,0,0"
                       Style="{StaticResource EmphasisTextStyle}"
                       TextWrapping="Wrap"
                       Text="Ctrl+S w Excel zapisuje zmiany do Revit." />
            <TextBlock x:Name="DetailText"
                       Margin="0,2,0,0"
                       Style="{StaticResource HintTextStyle}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</Window>
