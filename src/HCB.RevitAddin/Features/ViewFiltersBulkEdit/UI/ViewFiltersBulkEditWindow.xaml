<Window x:Class="HCB.RevitAddin.Features.ViewFiltersBulkEdit.UI.ViewFiltersBulkEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HCB.RevitAddin.UI.Controls"
        Title="View Filters Bulk Edit"
        Width="520"
        Height="320"
        MinWidth="480"
        MinHeight="300"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource HcbWindowStyle}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HCB.RevitAddin;component/UI/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Style="{StaticResource DialogRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:DialogHeader Title="View Filters Bulk Edit"
                               Description="Zmienia stan i widoczność zaznaczonych filtrów widoku naraz." />

        <GroupBox Grid.Row="1"
                  Margin="{StaticResource Space.Section}"
                  VerticalAlignment="Top"
                  Header="Akcje">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource FormLabelColumnWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource FieldLabelStyle}"
                           Margin="0,0,12,8"
                           Text="Stan filtra" />
                <ComboBox x:Name="EnableModeComboBox"
                          Grid.Column="1"
                          Margin="{StaticResource Space.Field}"
                          SelectedIndex="0">
                    <ComboBoxItem Content="Bez zmian" Tag="NoChange" />
                    <ComboBoxItem Content="Włączony" Tag="Enable" />
                    <ComboBoxItem Content="Wyłączony" Tag="Disable" />
                </ComboBox>
                <TextBlock Grid.Row="1"
                           Style="{StaticResource FieldLabelStyle}"
                           Text="Widoczność filtra" />
                <ComboBox x:Name="VisibilityModeComboBox"
                          Grid.Row="1"
                          Grid.Column="1"
                          SelectedIndex="0">
                    <ComboBoxItem Content="Bez zmian" Tag="NoChange" />
                    <ComboBoxItem Content="Pokaż" Tag="Visible" />
                    <ComboBoxItem Content="Ukryj" Tag="Hidden" />
                </ComboBox>
            </Grid>
        </GroupBox>

        <controls:DialogFooterBar x:Name="FooterBar"
                                  Grid.Row="2"
                                  Margin="{StaticResource Space.Section}"
                                  PrimaryButtonText="Zastosuj"
                                  SecondaryButtonText="Anuluj"
                                  IsPrimaryDefault="True"
                                  PrimaryButtonClick="ConfirmButton_OnClick"
                                  SecondaryButtonClick="CancelButton_OnClick" />
    </Grid>
</Window>
