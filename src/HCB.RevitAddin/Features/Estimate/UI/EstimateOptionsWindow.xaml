<Window x:Class="HCB.RevitAddin.Features.Estimate.UI.EstimateOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HCB.RevitAddin.UI.Controls"
        Title="Estimate"
        Width="640"
        Height="320"
        MinWidth="560"
        MinHeight="300"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource HcbWindowStyle}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HCB.RevitAddin;component/UI/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Style="{StaticResource DialogRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:DialogHeader Title="Estimate"
                               Description="Aktualizuje HC_Cena_Jednostkowa i HC_Koszt dla elementów wentylacji na podstawie wybranego cennika." />

        <GroupBox Grid.Row="1"
                  Margin="{StaticResource Space.Section}"
                  VerticalAlignment="Top"
                  Header="Ustawienia cennika">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource FormLabelColumnWidth}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Margin="0,0,12,8"
                           Style="{StaticResource FieldLabelStyle}"
                           Text="Plik CSV" />

                <TextBox x:Name="CatalogPathTextBox"
                         Grid.Row="0"
                         Grid.Column="1"
                         Margin="0,0,8,8" />

                <Button Grid.Row="0"
                        Grid.Column="2"
                        Margin="{StaticResource Space.Field}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="Przeglądaj…"
                        Click="BrowseButton_OnClick" />

                <CheckBox x:Name="AddFoilCheckBox"
                          Grid.Row="1"
                          Grid.Column="1"
                          Grid.ColumnSpan="2"
                          Margin="0,4,0,0"
                          Content="Dolicz foliowanie dla prostokątnych Duct i Duct Fitting" />
            </Grid>
        </GroupBox>

        <controls:DialogFooterBar x:Name="FooterBar"
                                  Grid.Row="2"
                                  Margin="{StaticResource Space.Section}"
                                  PrimaryButtonText="Przelicz"
                                  SecondaryButtonText="Anuluj"
                                  PrimaryButtonClick="ConfirmButton_OnClick"
                                  SecondaryButtonClick="CancelButton_OnClick" />
    </Grid>
</Window>
