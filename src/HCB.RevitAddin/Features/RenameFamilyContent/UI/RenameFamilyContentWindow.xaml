<Window x:Class="HCB.RevitAddin.Features.RenameFamilyContent.UI.RenameFamilyContentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HCB.RevitAddin.UI.Controls"
        Title="Rename Family Parameters"
        Width="620"
        Height="480"
        MinWidth="520"
        MinHeight="460"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource HcbWindowStyle}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HCB.RevitAddin;component/UI/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Style="{StaticResource DialogRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:DialogHeader Title="Rename Family Parameters"
                               Description="Zmienia nazwy parametrów rodzinnych według prefiksu, sufiksu oraz reguły szukaj i zamień." />

        <StackPanel Grid.Row="1"
                    Margin="{StaticResource Space.Section}">
            <GroupBox Header="Reguły nazw">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource FormLabelColumnWidth}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                               Text="Prefiks" />
                    <TextBox x:Name="PrefixTextBox"
                             Grid.Column="1"
                             Margin="{StaticResource Space.Field}" />

                    <TextBlock Grid.Row="1"
                               Style="{StaticResource FieldLabelStyle}"
                               Text="Szukaj" />
                    <TextBox x:Name="FindTextBox"
                             Grid.Row="1"
                             Grid.Column="1"
                             Margin="{StaticResource Space.Field}" />

                    <TextBlock Grid.Row="2"
                               Style="{StaticResource FieldLabelStyle}"
                               Text="Zamień na" />
                    <TextBox x:Name="ReplaceTextBox"
                             Grid.Row="2"
                             Grid.Column="1"
                             Margin="{StaticResource Space.Field}" />

                    <TextBlock Grid.Row="3"
                               Style="{StaticResource FieldLabelStyle}"
                               Text="Sufiks" />
                    <TextBox x:Name="SuffixTextBox"
                             Grid.Row="3"
                             Grid.Column="1" />
                </Grid>
            </GroupBox>

            <GroupBox Margin="{StaticResource Space.Section}"
                      Header="Tryb zapisu">
                <StackPanel>
                    <CheckBox x:Name="SaveAsCopyCheckBox"
                              Content="Zapisz jako kopię do wskazanego folderu"
                              IsChecked="True"
                              Checked="SaveAsCopyCheckBox_OnChanged"
                              Unchecked="SaveAsCopyCheckBox_OnChanged" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="OutputFolderTextBox"
                                 IsReadOnly="True" />
                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="Wybierz folder"
                                Click="BrowseOutputFolderButton_OnClick" />
                    </Grid>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <controls:DialogFooterBar x:Name="FooterBar"
                                  Grid.Row="2"
                                  Margin="{StaticResource Space.Section}"
                                  PrimaryButtonText="Zmień parametry"
                                  SecondaryButtonText="Anuluj"
                                  PrimaryButtonClick="ConfirmButton_OnClick"
                                  SecondaryButtonClick="CancelButton_OnClick" />
    </Grid>
</Window>
