<Window x:Class="HCB.RevitAddin.Features.RotateFittings.UI.RotateFittingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HCB.RevitAddin.UI.Controls"
        Title="Rotate Fittings"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource HcbWindowStyle}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HCB.RevitAddin;component/UI/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="{StaticResource Space.DialogPadding}">
        <controls:DialogHeader Title="Rotate Fittings"
                               Description="Obraca klikane kształtki o wybrany kąt wokół wybranej osi." />

        <GroupBox Margin="{StaticResource Space.Section}"
                  Header="Kąt obrotu (klik = obracaj o ten kąt)">
            <StackPanel>
                <UniformGrid Columns="4"
                             Rows="2"
                             Margin="0,0,0,10">
                    <Button Margin="0,0,6,6" Content="+45°" Tag="45" Style="{StaticResource InlineActionButtonStyle}" Click="PresetButton_OnClick" />
                    <Button Margin="0,0,6,6" Content="+90°" Tag="90" Style="{StaticResource InlineActionButtonStyle}" Click="PresetButton_OnClick" />
                    <Button Margin="0,0,6,6" Content="+135°" Tag="135" Style="{StaticResource InlineActionButtonStyle}" Click="PresetButton_OnClick" />
                    <Button Margin="0,0,0,6" Content="180°" Tag="180" Style="{StaticResource InlineActionButtonStyle}" Click="PresetButton_OnClick" />
                    <Button Margin="0,0,6,0" Content="-45°" Tag="-45" Style="{StaticResource InlineActionButtonStyle}" Click="PresetButton_OnClick" />
                    <Button Margin="0,0,6,0" Content="-90°" Tag="-90" Style="{StaticResource InlineActionButtonStyle}" Click="PresetButton_OnClick" />
                    <Button Margin="0,0,6,0" Content="-135°" Tag="-135" Style="{StaticResource InlineActionButtonStyle}" Click="PresetButton_OnClick" />
                    <Button Margin="0" Content="-180°" Tag="-180" Style="{StaticResource InlineActionButtonStyle}" Click="PresetButton_OnClick" />
                </UniformGrid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                               Text="Własny kąt" />
                    <TextBox x:Name="AngleTextBox"
                             Grid.Column="1"
                             KeyDown="AngleTextBox_OnKeyDown"
                             TextChanged="AngleTextBox_OnTextChanged" />
                    <TextBlock Grid.Column="2"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Text="°" />
                </Grid>
            </StackPanel>
        </GroupBox>

        <GroupBox Margin="{StaticResource Space.Section}"
                  Header="Oś obrotu">
            <StackPanel>
                <RadioButton x:Name="ConnectorAxisRadioButton"
                             Margin="0,0,0,6"
                             GroupName="Axis"
                             Content="Oś podłączonego konektora (najbliżej kliknięcia)" />
                <RadioButton x:Name="VerticalAxisRadioButton"
                             GroupName="Axis"
                             Content="Oś pionowa Z przez punkt wstawienia" />
            </StackPanel>
        </GroupBox>

        <GroupBox Margin="{StaticResource Space.Section}"
                  Header="Kategorie">
            <WrapPanel>
                <CheckBox x:Name="DuctFittingsCheckBox"
                          Margin="0,0,16,0"
                          Content="Duct" />
                <CheckBox x:Name="PipeFittingsCheckBox"
                          Margin="0,0,16,0"
                          Content="Pipe" />
                <CheckBox x:Name="ConduitFittingsCheckBox"
                          Content="Conduit" />
            </WrapPanel>
        </GroupBox>

        <Border Margin="{StaticResource Space.Section}"
                Style="{StaticResource InfoPanelStyle}">
            <TextBlock Style="{StaticResource HintTextStyle}"
                       Text="Klikaj kształtki w widoku. ESC w Revicie wstrzymuje wskazywanie – okno zostaje, Revit działa normalnie. Zamknij kończy obracanie. Kąt + = przeciwnie do wskazówek zegara, patrząc od strony konektora osi (oś Z: z góry)." />
        </Border>

        <controls:DialogFooterBar x:Name="FooterBar"
                                  Margin="{StaticResource Space.Section}"
                                  PrimaryButtonText="Wskaż kształtki"
                                  SecondaryButtonText="Zamknij"
                                  PrimaryButtonClick="PickButton_OnClick"
                                  SecondaryButtonClick="CloseButton_OnClick" />
    </StackPanel>
</Window>
