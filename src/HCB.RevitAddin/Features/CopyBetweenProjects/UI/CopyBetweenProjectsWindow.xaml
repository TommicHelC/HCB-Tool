<Window x:Class="HCB.RevitAddin.Features.CopyBetweenProjects.UI.CopyBetweenProjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HCB.RevitAddin.UI.Controls"
        Title="Copy Between Projects"
        Width="760"
        Height="760"
        MinWidth="680"
        MinHeight="600"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource HcbWindowStyle}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HCB.RevitAddin;component/UI/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Style="{StaticResource DialogRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:DialogHeader Title="Copy Between Projects"
                               Description="Kopiuje wybrane elementy z jednego otwartego projektu do drugiego." />

        <GroupBox Grid.Row="1"
                  Margin="{StaticResource Space.Section}"
                  Header="Projekty">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource FormLabelColumnWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource FieldLabelStyle}"
                           Margin="0,0,12,8"
                           Text="Kopiuj z" />
                <ComboBox x:Name="SourceDocumentComboBox"
                          Grid.Column="1"
                          Margin="{StaticResource Space.Field}"
                          SelectionChanged="DocumentComboBox_OnSelectionChanged" />
                <TextBlock Grid.Row="1"
                           Style="{StaticResource FieldLabelStyle}"
                           Text="Wklej do" />
                <ComboBox x:Name="TargetDocumentComboBox"
                          Grid.Row="1"
                          Grid.Column="1"
                          SelectionChanged="DocumentComboBox_OnSelectionChanged" />
            </Grid>
        </GroupBox>

        <GroupBox x:Name="ItemsGroupBox"
                  Grid.Row="2"
                  Margin="{StaticResource Space.Section}"
                  Header="Elementy do skopiowania">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top"
                           Margin="0,0,0,4"
                           Style="{StaticResource SectionLabelStyle}"
                           Text="Szukaj" />
                <TextBox x:Name="SearchTextBox"
                         DockPanel.Dock="Top"
                         Margin="{StaticResource Space.Field}"
                         TextChanged="SearchTextBox_OnTextChanged" />

                <StackPanel x:Name="PrimaryFilterPanel"
                            DockPanel.Dock="Top"
                            Margin="{StaticResource Space.Field}"
                            Visibility="Collapsed">
                    <TextBlock Margin="0,0,0,4"
                               Style="{StaticResource SectionLabelStyle}"
                               Text="Kategoria" />
                    <ComboBox x:Name="FilterGroupComboBox"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Value"
                              SelectionChanged="FilterGroupComboBox_OnSelectionChanged" />
                </StackPanel>

                <StackPanel x:Name="SecondaryFilterPanel"
                            DockPanel.Dock="Top"
                            Margin="{StaticResource Space.Field}"
                            Visibility="Collapsed">
                    <TextBlock Margin="0,0,0,4"
                               Style="{StaticResource SectionLabelStyle}"
                               Text="Typ" />
                    <ComboBox x:Name="SecondaryFilterGroupComboBox"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Value"
                              SelectionChanged="SecondaryFilterGroupComboBox_OnSelectionChanged" />
                </StackPanel>

                <controls:SelectionActionsBar DockPanel.Dock="Top"
                                              Margin="0,0,0,8"
                                              LeftButtonText="Wszystkie"
                                              RightButtonText="Brak"
                                              LeftButtonClick="SelectAllButton_OnClick"
                                              RightButtonClick="SelectNoneButton_OnClick" />
                <ListBox x:Name="ItemsListBox"
                         DisplayMemberPath="DisplayName"
                         SelectionMode="Extended"
                         SelectionChanged="ItemsListBox_OnSelectionChanged" />
            </DockPanel>
        </GroupBox>

        <controls:DialogFooterBar x:Name="FooterBar"
                                  Grid.Row="3"
                                  Margin="{StaticResource Space.Section}"
                                  PrimaryButtonText="Kopiuj"
                                  SecondaryButtonText="Anuluj"
                                  PrimaryButtonClick="ConfirmButton_OnClick"
                                  SecondaryButtonClick="CancelButton_OnClick" />
    </Grid>
</Window>
